<script>
    window.__appNav = window.__appNav || {};

    // ✅ helper: define una ventana de “salida intencional”
    window.__appNav.markIntentionalExit = function (ms) {
      const ttl = ms ?? 5000; // 5s por defecto
      window.__appNav.intentionalExitUntil = Date.now() + ttl;
    };

    // ✅ helper: consulta si estamos en salida intencional
    window.__appNav.isIntentionalExit = function () {
      return !!window.__appNav.intentionalExitUntil && Date.now() < window.__appNav.intentionalExitUntil;
    };

    window.addEventListener('beforeunload', () => {

      // ✅ si estamos abriendo mailto / acción externa, NO cerrar sesión
      if (window.__appNav.isIntentionalExit()) {
        return;
      }

      const claveLicencia = localStorage.getItem('clave_licencia');
      const dispositivoSesionId = localStorage.getItem('dispositivo_sesion_id');

      // si faltan datos, no tiene sentido llamar
      if (!claveLicencia || !dispositivoSesionId) return;

      const data = { claveLicencia, dispositivoSesionId };

      fetch('https://api-sistema-frfeh8g2h5cgduab.canadacentral-01.azurewebsites.net/api/Sesiones/cerrar-sesion', {
        method: 'POST',
        body: JSON.stringify(data),
        headers: { 'Content-Type': 'application/json' },
        keepalive: true
      });
    });
</script>






