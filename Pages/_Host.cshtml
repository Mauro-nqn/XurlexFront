<script>
    let inactivityTimeout;
    let warningTimeout;
    const logoutAfter = 15 * 60 * 1000; // 15 minutos
    const warningBefore = 30 * 1000;    // mostrar aviso 30 segundos antes

    function resetInactivityTimer() {
        clearTimeout(inactivityTimeout);
        clearTimeout(warningTimeout);

        const token = localStorage.getItem("token");
        if (!token || token === "undefined" || token === "null" || token.trim() === "")
            return;

        inactivityTimeout = setTimeout(() => {
            showInactivityWarning();
        }, logoutAfter - warningBefore);
    }

    function showInactivityWarning() {
        const token = localStorage.getItem("token");
        if (!token || token === "undefined" || token === "null" || token.trim() === "")
            return;

        const overlay = document.createElement("div");
        overlay.id = "inactivity-overlay";
        overlay.style.position = "fixed";
        overlay.style.top = "0";
        overlay.style.left = "0";
        overlay.style.width = "100%";
        overlay.style.height = "100%";
        overlay.style.backgroundColor = "rgba(0,0,0,0.5)";
        overlay.style.display = "flex";
        overlay.style.flexDirection = "column";
        overlay.style.justifyContent = "center";
        overlay.style.alignItems = "center";
        overlay.style.zIndex = "9999";
        overlay.innerHTML = `
            <div style="background:white;padding:20px;border-radius:8px;text-align:center;">
                <p>Tu sesión se cerrará por inactividad en <strong>30 segundos</strong>.</p>
                <button id="continuar-sesion" class="btn btn-primary">Continuar sesión</button>
            </div>
        `;
        document.body.appendChild(overlay);

        document.getElementById("continuar-sesion").onclick = () => {
            const ov = document.getElementById("inactivity-overlay");
            if (ov) document.body.removeChild(ov);
            resetInactivityTimer();
        };

        // ⏰ A los 30 segundos: cerrar de verdad
        warningTimeout = setTimeout(async () => {



             //  Si fue un mailto (o acción “externa”), NO cierres sesión
            if (window.__inact && window.__inact.pauseUntil && Date.now() < window.__inact.pauseUntil) {
                resetInactivityTimer();

                const ov = document.getElementById("inactivity-overlay");
                if (ov) document.body.removeChild(ov);

                return; // ⛔ NO cerrar sesión
            }

            // por si en esos 30 segundos se cerró por otro lado
            const tk = localStorage.getItem("token");
            if (!tk || tk === "undefined" || tk === "null" || tk.trim() === "") {
                const ov = document.getElementById("inactivity-overlay");
                if (ov) document.body.removeChild(ov);
                return;
            }

            // 1) limpiamos timers, eventos y token en el front
            detenerInactividad();

            // 2) avisamos al backend que cerramos sesión
            try {
                const claveLicencia = localStorage.getItem('clave_licencia');
                const dispositivoSesionId = localStorage.getItem('dispositivo_sesion_id');

                if (typeof backendUrl !== 'undefined' &&
                    backendUrl &&
                    claveLicencia &&
                    dispositivoSesionId) {


                    await fetch(`${backendUrl}/api/Sesiones/cerrar-sesion`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ claveLicencia, dispositivoSesionId }),
                        keepalive: true
                    });
                }
            } catch (err) {
                console.error("Error cerrar-sesion por inactividad:", err);
            }

            // 3) disparamos la lógica de logout en Blazor
            try {
                await DotNet.invokeMethodAsync('IurixBlazor', 'CerrarSesionPorInactividad');
            } catch (err) {
                console.error("Error en CerrarSesionPorInactividad:", err);
            }

        }, warningBefore);
    }

    //  Esta es la función que se debe llamar después del login
    function iniciarInactividad() {
        const token = localStorage.getItem("token");
        if (!token || token === "undefined" || token === "null" || token.trim() === "")
            return;

        window.addEventListener('mousemove', resetInactivityTimer);
        window.addEventListener('keydown', resetInactivityTimer);
        resetInactivityTimer();
    }

    function detenerInactividad() {
        clearTimeout(inactivityTimeout);
        clearTimeout(warningTimeout);
        window.removeEventListener('mousemove', resetInactivityTimer);
        window.removeEventListener('keydown', resetInactivityTimer);

        // sacamos token local para que nada más considere que hay sesión
        localStorage.removeItem("token");

        const overlay = document.getElementById("inactivity-overlay");
        if (overlay) document.body.removeChild(overlay);
    }
</script>

<script>
    const backendUrl = "@Config.ServidorBackendUrl";
</script>



<script>
    let huboActividad = false;
    const intervaloEnvio = 5 * 60 * 1000; // cada 5 minutos

    function marcarActividad() {
        huboActividad = true;
    }

    async function enviarActividadSiCorresponde() {
        if (!huboActividad) {
            console.log("[Actividad] Sin movimiento reciente, no se envía.");
            return;
        }

        const claveLicencia = localStorage.getItem('clave_licencia');
        const dispositivoSesionId = localStorage.getItem('dispositivo_sesion_id');

        if (!claveLicencia || !dispositivoSesionId || typeof backendUrl === 'undefined') {
            console.warn("[Actividad] Datos faltantes, no se envía.");
            return;
        }

        try {
            const res = await fetch(`${backendUrl}/api/Sesiones/actualizar-actividad`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ claveLicencia, dispositivoSesionId })
            });
            console.log("[Actividad] Enviado. Status:", res.status);
        } catch (err) {
            console.error("[Actividad] Error al enviar:", err);
        }

        huboActividad = false; // reseteamos el flag
    }

    window.addEventListener('mousemove', marcarActividad);
    window.addEventListener('keydown', marcarActividad);

    setInterval(enviarActividadSiCorresponde, intervaloEnvio);
</script>








































































