@attribute [Authorize]

@inherits MovimientosEmbedBase

<div class="mt-3">
    @if (Cargando)
    {
        <div class="text-muted">Cargando movimientos…</div>
    }
    else if (Movimientos.Count == 0)
    {
        <div class="text-muted">Sin movimientos.</div>
    }
    else
    {
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Título</th>
                    <th style="width:1%"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Movimientos)
                {
                    <tr>
                        <td>@m.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@m.Titulo</td>
                        <td class="text-nowrap">
                            <button class="btn btn-outline-secondary btn-sm px-2 py-1 me-1"
                                    disabled="@(!HayAdjuntos(m))"
                                    @onclick="@(() => VerAdjuntos(m.Id))"
                                    title="Adjuntos">
                                <i class="bi bi-paperclip"></i>
                                @if (m.CantidadArchivos > 0)
                                {
                                    <span class="badge bg-secondary ms-1">@m.CantidadArchivos</span>
                                }
                            </button>
                            <button class="btn btn-outline-primary btn-sm px-2 py-1 me-1"
                                    @onclick="@(() => VerMovimiento(m.Id))"
                                    title="Ver">
                                <i class="bi bi-eyeglasses"></i>
                            </button>
                            <button class="btn btn-outline-danger btn-sm px-2 py-1" @onclick="@(() => EliminarMovimiento(m.Id))" title="Eliminar">
                                <i class="bi bi-trash3-fill"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="d-flex gap-2">
        <button class="btn btn-secondary btn-sm" @onclick="IrAListaCompleta">
            Ver todos los movimientos
        </button>

        @if (PuedeSincronizar)
        {
            <button class="btn btn-warning btn-sm"
                    title="Sincronizar con Dextra"
                    disabled="@IsSyncing(ProcesoId)"
                    @onclick="() => SyncUno(ProcesoId)">
                @if (IsSyncing(ProcesoId))
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>Sincronizando…</span>
                }
                else
                {
                    <span><i class="bi bi-cloud-arrow-down"></i> Dextra</span>
                }
            </button>
        }
    </div>
</div>


<AdjuntosModal @ref="_adjuntosModal" />
<VerMovimientoModal @ref="_movModal" OnSaved="RecargarDespuesDeEditar" OnClosed="ReabrirPadre" />