                </button>
            }
        </PermisoView>



        @* @if (!EstaAnulado && saldo > 0m)
        {
            <button class="btn btn-success ms-2" @onclick="AbrirImputarRecibo">💸 Imputar</button>
        }

        <PermisoView Permiso="@Permisos.Recibos.Anular">
