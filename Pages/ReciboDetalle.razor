    .recibo-a4 {
        max-width: 900px;
        margin: 0 auto;
        background: #fff;
        padding: 24px
    }

    .recibo-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #e5e7eb;
        padding-bottom: 12px;
        margin-bottom: 16px
    }

    .brand {
        display: flex;
        gap: 12px;
        align-items: center
    }

    .logo {
        height: 56px
    }

    .logo-estudio {
        max-width: 100%;
        max-height: 120px; /* alto máximo razonable para encabezado */
        object-fit: contain; /* mantiene proporciones sin recortar */
        display: inline-block;
    }

    .brand-text h1 {
        font-size: 22px;
        margin: 0
    }

    .brand-text .muted {
        color: #6b7280
    }

    .estado .badge {
        display: inline-block;
        padding: .35rem .6rem;
        border-radius: 999px;
        font-size: .85rem
    }

    .badge-warning {
        background: #fff7ed;
        border: 1px solid #fdba74;
        color: #9a3412
    }

    .badge-info {
        background: #eff6ff;
        border: 1px solid #93c5fd;
        color: #1d4ed8
    }

    .badge-success {
        background: #ecfdf5;
        border: 1px solid #86efac;
        color: #065f46
    }

    .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px
    }

    .panel {
        background: #fafafa;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 16px
    }

    .panel-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8px
    }

    .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px
    }

        .grid-2 .span-2 {
            grid-column: 1 / -1
        }

    .totals .kpis {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 8px
    }

    .kpis .label {
        font-size: .8rem;
        color: #6b7280
    }

    .kpis .value {
        font-size: 1.15rem;
        font-weight: 700
    }

    .table th, .table td {
        vertical-align: middle
    }
    @@media (max-width:720px) {
        .grid

    {
        grid-template-columns: 1fr
    }

    .totals .kpis {
        grid-template-columns: 1fr
    }

    }
    @@media print {
        .acciones-no-print

    {
        display: none
    }

    body {
        background: #fff
    }

    .panel {
        border: none;
        padding: 0
    }

    .recibo-header {
        border-bottom: none
    }

        .logo-estudio {
            max-height: 80px; /* en impresión, un poco más chico */
        }

    

    
  body * { visibility: hidden; }
  #print-root, #print-root * { visibility: visible; }
  #print-root { position: absolute; left: 0; top: 0; }
  .acciones-no-print { display: none !important; }
  
}




</style>
