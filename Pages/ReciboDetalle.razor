@* @page "/recibos/{Id:int}"
@inherits ReciboDetalleBase
@layout AdminLayout

<div class="recibo-a4">
    <header class="recibo-header">
        <!-- encabezado -->
        <div class="row align-items-center">
            <div class="col-3 text-center">
                <img src="@LogoUrl" alt="Logo" class="logo-estudio" />
            </div>
            <div class="col-9">                
                <div class="muted">@NombreEstudio</div>
            </div>
        </div>
        
            <div class="brand-text">
                <h1>RECIBO</h1>
                <div class="muted">N.º @Vista?.Recibo.Id</div>
            </div>
        

        @if (Vista is not null)
        {
            var total = Vista.Recibo.Total;
            var imp = Vista.TotalImputado;
            var saldo = Vista.SaldoResultante;

            <div class="estado">
                @if (imp <= 0)
                {
                    <span class="badge badge-warning">Anticipo sin imputar</span>
                }
                else if (imp < total)
                {
                    <span class="badge badge-info">Parcialmente imputado</span>
                }
                else
                {
                    <span class="badge badge-success">Totalmente imputado</span>
                }
            </div>
        }
    </header>

    <section class="grid">
        <div class="panel">
            <h4>Datos</h4>
            <div class="grid-2">
                <div><b>Fecha:</b> @(Vista?.Recibo?.Fecha is DateTime f ? f.ToLocalTime().ToString("dd/MM/yyyy") : "-")</div>
                <div><b>Medio de Pago:</b> @MedioPagoNombre</div>
                <div class="span-2"><b>Cliente:</b> @ClienteNombre</div>
                @if (!string.IsNullOrWhiteSpace(Vista?.Recibo.Observaciones))
                {
                    <div class="span-2"><b>Concepto:</b> @Vista!.Recibo.Observaciones</div>
                }
            </div>
        </div>

        <div class="panel totals">
            <h4>Totales</h4>
            <div class="kpis">
                <div><div class="label">Total Recibo</div><div class="value">@Vista?.Recibo.Total.ToString("C")</div></div>
                <div><div class="label">Imputado</div><div class="value">@Vista?.TotalImputado.ToString("C")</div></div>
                <div><div class="label">Saldo</div><div class="value">@Vista?.SaldoResultante.ToString("C")</div></div>
            </div>
        </div>
    </section>

    <section class="panel">
        <div class="panel-title">
            <h4>Imputaciones</h4>
            @* acá podrías mostrar acciones según tu política (p.ej. “Imputar”) 
        </div>

        <table class="table table-sm">
            <thead>
                <tr><th>Fecha</th><th>Concepto</th><th class="text-end">Importe</th></tr>
            </thead>
            <tbody>
                @if (Vista?.Imputaciones?.Count > 0)
                {
                    @foreach (var i in Vista.Imputaciones)
                    {
                        <tr>
                            <td>@i.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td>@i.Concepto</td>
                            <td class="text-end">@i.Importe.ToString("C")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="3" class="text-center text-muted py-4">@* No hay imputaciones para este recibo. </td></tr>
                }


            </tbody>
        </table>
    </section>

    <div>Recibimos la suma de  <b>@Vista?.Recibo.Total.ToString("C") (@ImporteEnLetras)</b> de @ClienteNombre</div>
    <div><b>En concepto de:</b> @Vista?.Recibo.Observaciones</div>


    <footer>
    <div class="firma mt-5">
        <div>@NombreEstudio</div>
        <div class="muted">@PieEstudio</div>
    </div>
    </footer>

    <div class="acciones-no-print mt-3">
        <button class="btn btn-secondary" @onclick="Volver">← Volver</button>
        <button class="btn btn-primary ms-2" @onclick="Imprimir">🖨 Imprimir</button>
        @if ((Vista?.SaldoResultante ?? 0m) > 0m)
        {
            <button class="btn btn-success ms-2" @onclick="AbrirImputarRecibo">💸 Imputar</button>
        }


    </div> *@

@attribute [Authorize]

@page "/recibos/{Id:int}"
@inherits ReciboDetalleBase
@layout AdminLayout

@{
    var total = Vista?.Recibo.Total ?? 0m;
    var imp = Vista?.TotalImputado ?? 0m;
    var saldo = Vista?.SaldoResultante ?? (total - imp);
    var hayImputaciones = (Vista?.Imputaciones?.Count ?? 0) > 0;
}

<div id="print-root" class="recibo-a4">
    <header class="recibo-header">
        <div class="row align-items-center w-100">
            <div class="col-3 text-center">
                <img src="@LogoUrl" alt="Logo" class="logo-estudio" />
            </div>
            <div class="col-9">
                <h2 class="mb-1">RECIBO</h2>
                <div class="muted">N.º @Vista?.Recibo.Id</div>
                <div class="muted">@NombreEstudio</div>
            </div>
        </div>

@*         @if (hayImputaciones)
        {
            <div class="estado mt-2">
                @if (imp < total)
                {
                    <span class="badge badge-info">Parcialmente imputado</span>
                }
                else
                {
                    <span class="badge badge-success">Totalmente imputado</span>
                }
            </div>
        } *@

        @if (EstaAnulado)
        {
            <div class="estado mt-2">
                <span class="badge badge-warning">ANULADO</span>
                @if (Vista?.Recibo.FechaAnulacion is DateTime fa)
                {
                    <small class="ms-2 text-muted">el @fa.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                }
            </div>
        }
        else if (hayImputaciones)
        {
            <div class="estado mt-2">
                @if (imp < total)
                {
                    <span class="badge badge-info">Parcialmente imputado</span>
                }
                else
                {
                    <span class="badge badge-success">Totalmente imputado</span>
                }
            </div>
        }
    </header>

    <section class="panel">
        <h4>Datos</h4>
        <div class="grid-2">
            <div><b>Fecha:</b> @(Vista?.Recibo?.Fecha is DateTime f ? f.ToLocalTime().ToString("dd/MM/yyyy") : "-")</div>
            <div><b>Medio de Pago:</b> @MedioPagoNombre</div>
            <div class="span-2"><b>Cliente:</b> @ClienteNombre</div>
            @if (!string.IsNullOrWhiteSpace(Vista?.Recibo.Observaciones))
            {
                <div class="span-2"><b>Concepto:</b> @Vista!.Recibo.Observaciones</div>
            }
        </div>


    </section>

    <!-- MODO SIMPLE (cliente) -->
    @if (!hayImputaciones)
    {
        <section class="panel">
            <p class="lead">
                Recibimos la suma de <b>@total.ToString("C") (@ImporteEnLetras)</b> de <b>@ClienteNombre</b>.
            </p>
            @if (!string.IsNullOrWhiteSpace(Vista?.Recibo.Observaciones))
            {
                <p><b>En concepto de:</b> @Vista!.Recibo.Observaciones</p>
            }
        </section>
    }

    <!-- MODO CONTABLE: solo si hay imputaciones -->
    @if (hayImputaciones)
    {
        <section class="grid">
            <div class="panel totals">
                <h4>Totales</h4>
                <div class="kpis">
                    <div><div class="label">Total Recibo</div><div class="value">@total.ToString("C")</div></div>
                    <div><div class="label">Imputado</div><div class="value">@imp.ToString("C")</div></div>
                    <div><div class="label">Saldo</div><div class="value">@saldo.ToString("C")</div></div>
                </div>
            </div>
        </section>

        <section class="panel">
            <div class="panel-title">
                <h4>Imputaciones</h4>
            </div>
            <table class="table table-sm">
                <thead>
                    <tr><th>Fecha</th><th>Concepto</th><th class="text-end">Importe</th></tr>
                </thead>
                <tbody>
                    @foreach (var i in Vista!.Imputaciones!)
                    {
                        <tr>
                            <td>@i.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td>@i.Concepto</td>
                            <td class="text-end">@i.Importe.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }

    <footer class="mt-4">
        <div class="firma mt-5">
            <div>@NombreEstudio</div>
            <div class="muted">@PieEstudio</div>
        </div>
    </footer>

