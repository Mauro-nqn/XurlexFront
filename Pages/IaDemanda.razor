@attribute [Authorize]

@page "/ia/demandas/apremio"
@inherits IaDemandaBase
@using IurixBlazor.Shared.Iademandas
@layout AdminLayout

<h3>Generar demanda de apremio (MVP)</h3>

<EditForm Model="modelo" OnValidSubmit="GenerarDemanda">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="card mb-3">
        <div class="card-header">Abogado</div>
        <div class="card-body">
            <div class="mb-2">
                <label>Nombre</label>
                <InputText @bind-Value="modelo.Abogado.Nombre" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Matrícula</label>
                <InputText @bind-Value="modelo.Abogado.Matricula" class="form-control" />
            </div>
            <div class="mb-2">
                <label>CUIT</label>
                <InputText @bind-Value="modelo.Abogado.Cuit" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Condición IVA</label>
                <InputText @bind-Value="modelo.Abogado.CondicionIva" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Domicilio procesal</label>
                <InputText @bind-Value="modelo.Abogado.DomicilioProcesal" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Ciudad</label>
                <InputText @bind-Value="modelo.Abogado.Ciudad" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Provincia</label>
                <InputText @bind-Value="modelo.Abogado.Provincia" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Domicilio electrónico</label>
                <InputText @bind-Value="modelo.Abogado.DomicilioElectronico" class="form-control" />
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Actor (Cliente)</div>
        <div class="card-body">
            <div class="mb-2">
                <label>Nombre</label>
                <InputText @bind-Value="modelo.Cliente.Nombre" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Domicilio</label>
                <InputText @bind-Value="modelo.Cliente.Domicilio" class="form-control" />
            </div>
            <div class="mb-2">
                <label>CUIT</label>
                <InputText @bind-Value="modelo.Cliente.Cuit" class="form-control" />
            </div>
            <div class="mb-2">
                <label>DNI</label>
                <InputText @bind-Value="modelo.Cliente.Dni" class="form-control" />
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Demandado (Deudor)</div>
        <div class="card-body">
            <div class="mb-2">
                <label>Nombre</label>
                <InputText @bind-Value="modelo.Deudor.Nombre" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Domicilio</label>
                <InputText @bind-Value="modelo.Deudor.Domicilio" class="form-control" />
            </div>
            <div class="mb-2">
                <label>CUIT</label>
                <InputText @bind-Value="modelo.Deudor.Cuit" class="form-control" />
            </div>
            <div class="mb-2">
                <label>DNI</label>
                <InputText @bind-Value="modelo.Deudor.Dni" class="form-control" />
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Certificado de deuda</div>
        <div class="card-body">
            <div class="mb-2">
                <label>Monto</label>
                <InputNumber @bind-Value="modelo.Certificado.Monto" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Fecha certificado (yyyy-MM-dd)</label>
                <InputText @bind-Value="modelo.Certificado.FechaCertificado" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Fecha liquidación (yyyy-MM-dd)</label>
                <InputText @bind-Value="modelo.Certificado.FechaLiquidacion" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Número certificado</label>
                <InputText @bind-Value="modelo.Certificado.Numero" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Organismo emisor</label>
                <InputText @bind-Value="modelo.Certificado.OrganismoEmisor" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Dependencia</label>
                <InputText @bind-Value="modelo.Certificado.Dependencia" class="form-control" />
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Datos del proceso</div>
        <div class="card-body">
            <div class="mb-2">
                <label>Jurisdicción</label>
                <InputText @bind-Value="modelo.Jurisdiccion" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Juez competente / Juzgado</label>
                <InputText @bind-Value="modelo.JuezCompetente" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Tipo de crédito</label>
                <InputText @bind-Value="modelo.TipoCredito" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Observaciones</label>
                <InputText @bind-Value="modelo.Observaciones" class="form-control" />
            </div>
        </div>
    </div>

    <button class="btn btn-primary" type="submit">Generar demanda</button>
</EditForm>

@if (respuesta is not null)
{
    <hr />
    <h4>Borrador generado</h4>
    <textarea class="form-control" rows="20">@respuesta.BorradorDemanda</textarea>

    <h5 class="mt-3">Avisos</h5>
    <ul>
        @foreach (var aviso in respuesta.Avisos)
        {
            <li>@aviso</li>
        }
    </ul>
}

