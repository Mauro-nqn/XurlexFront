<div class="container mt-4">

    <h3>📚 Movimientos - @Titulo</h3>

    @if (!string.IsNullOrEmpty(NombreProceso))
    {
        <div class="alert alert-info">

            @if (Tipo == "Judicial")
            {
                <p><strong>Proceso:</strong> @NombreProceso <strong>Expte:</strong> @NumeroExpediente</p>
                <p><strong>Tipo Proceso:</strong> @TipoProceso </p>
                <p><strong>Juzgado Dextra:</strong> @(JuzgadoDextraAplicacionExacta ?? "—")</p>
            }
            else
            {
                <p><strong>Proceso:</strong> @NombreProceso </p>
                <p><strong>Tipo Proceso:</strong> @Materia </p>
            }
        </div>
    }

    @if (esMovil)
    {
        <!-- ===== MOBILE: botones apilados ===== -->
        <div class="mt-3 d-flex flex-column gap-2">
            <button class="btn btn-success w-100"
                    @onclick="@(() => Nav.NavigateTo($"/movimientos/{Tipo}/crear/{ProcesoId}"))">
                <i class="bi bi-plus-lg"></i> Agregar Movimiento
            </button>

            <button class="btn btn-danger w-100"
                    @onclick="EliminarTodosMovimientos">
                <i class="bi bi-trash3"></i> Eliminar TODOS los movimientos
            </button>

            <button class="btn btn-secondary w-100"
                    @onclick="VolverAGestiones">
                <i class="bi bi-arrow-left-circle"></i> Volver a Gestiones
            </button>

            @if (PuedeSincronizar)
            {
                <button class="btn btn-warning w-100"
                        title="Sincronizar con Dextra"
                        disabled="@(IsSyncing(ProcesoId) || IsConsulting)"
                        @onclick="() => SyncUno(ProcesoId)">

                    @if (IsConsulting)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span> Consultando…</span>
                    }
                    else if (IsSyncing(ProcesoId))
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span> Sincronizando…</span>
                    }
                    else
                    {
                        <span><i class="bi bi-cloud-arrow-down"></i> @TextoBotonDextra</span>
                    }
                </button>
            }
        </div>

        @if (MostrarSugerenciaMic)
        {
            <div class="alert alert-warning mic-hint mb-3">
                <span class="mic-text">
                    🎙️ Para responder <b>sí / no</b> por voz, habilitá el micrófono
                </span>

                <button class="btn btn-sm btn-outline-dark mic-btn"
                        @onclick="HabilitarMicAsync">
                    Habilitar
                </button>
            </div>
        }
    }
    else
    {
        <!-- ===== DESKTOP: botones en fila ===== -->
        <div class="mt-4 d-flex flex-wrap align-items-center gap-2">
            <button class="btn btn-success me-2"
                    @onclick="@(() => Nav.NavigateTo($"/movimientos/{Tipo}/crear/{ProcesoId}"))">
                <i class="bi bi-plus-lg"></i> Agregar Movimiento
            </button>

            <button class="btn btn-danger me-2"
                    @onclick="EliminarTodosMovimientos">
                <i class="bi bi-trash3"></i> Eliminar TODOS los movimientos
            </button>

            <button class="btn btn-secondary me-2"
                    @onclick="VolverAGestiones">
                <i class="bi bi-arrow-left-circle"></i> Volver a Gestiones
            </button>

            @if (PuedeSincronizar)
            {
                <button class="btn btn-warning"
                        title="Sincronizar con Dextra"
                        disabled="@(IsSyncing(ProcesoId) || IsConsulting)"
                        @onclick="() => SyncUno(ProcesoId)"
                        style="margin-left:5px">

                    @if (IsConsulting)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span>Consultando…</span>
                    }
                    else if (IsSyncing(ProcesoId))
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span>Sincronizando…</span>
                    }
                    else
                    {
                        <span><i class="bi bi-cloud-arrow-down"></i> @TextoBotonDextra</span>
                    }
                </button>
            }
        </div>
    }






    
    @if (Movimientos == null || !Movimientos.Any())
