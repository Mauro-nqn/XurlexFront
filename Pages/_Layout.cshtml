    <script>
        (function () {
          const overlay = document.getElementById("reconnectOverlay");
          const countdownEl = document.getElementById("reconnectCountdown");

          let countdownTimer = null;
          let autoReloadTimer = null;

          function showOverlay(secondsToReload) {
            if (!overlay) return;
            overlay.style.display = "flex";

            let s = secondsToReload ?? 15;
            if (countdownEl) countdownEl.textContent = String(s);

            if (countdownTimer) clearInterval(countdownTimer);
            countdownTimer = setInterval(() => {
              s--;
              if (countdownEl) countdownEl.textContent = String(Math.max(s, 0));
            }, 1000);

            if (autoReloadTimer) clearTimeout(autoReloadTimer);
            autoReloadTimer = setTimeout(() => {
              location.reload();
            }, (secondsToReload ?? 15) * 1000);
          }

          function hideOverlay() {
            if (!overlay) return;
            overlay.style.display = "none";
            if (countdownTimer) clearInterval(countdownTimer);
            if (autoReloadTimer) clearTimeout(autoReloadTimer);
            countdownTimer = null;
            autoReloadTimer = null;
          }

          // Si el usuario vuelve a la pestaña (pantalla encendida), y quedó “colgado”,
          // intentamos una recarga suave después de unos segundos si sigue desconectado.
          document.addEventListener("visibilitychange", () => {
            if (document.visibilityState === "visible") {
              // si el overlay está visible, damos un pequeño margen y luego recargamos
              if (overlay && overlay.style.display === "flex") {
                setTimeout(() => location.reload(), 4000);
              }
            }
          });

          const reconnectionHandler = {
            onConnectionDown: (options, error) => {
              console.log("Blazor: conexión caída", error);
              // Mostramos overlay y auto-recargamos si no vuelve
              showOverlay(15);
              return true; // deja que Blazor intente reconectar
            },
            onConnectionUp: () => {
              console.log("Blazor: reconectado");
              hideOverlay();
            }
          };

          Blazor.start({
            reconnectionHandler,
            reconnectionOptions: {
              maxRetries: 10,
              retryIntervalMilliseconds: 2000
            }
          }).catch(err => console.error("Error iniciando Blazor:", err));
        })();
    </script>

 
    


