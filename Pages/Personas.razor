    @if (!esMovil)
    {
        <!-- ESCRITORIO / TABLET HORIZONTAL: TABLA CLÁSICA -->
        <div class="table-responsive shadow-sm">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th width="40%">Razón Social / Apellido Nombre</th>
                        <th width="10%" class="text-center">DNI</th>
                        <th width="15%" class="text-center">CUIT</th>
                        <th width="15%" class="text-center">Celular</th>
                        <th width="20%" class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var persona in PersonasFiltradas)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(persona.RazonSocial))
                                {
                                    @persona.RazonSocial
                                }
                                else
                                {
                                    @($"{persona.Apellido}, {persona.Nombre}")
                                }
                            </td>

                            <td class="text-center">@persona.DNI</td>
                            <td class="text-center">@FormatearCUITVista(persona.CUIT)</td>
                            <td class="text-center">@persona.Celular</td>

                            <td class="text-center">
                                <PermisoView Permiso="@Permisos.CuentasCorrientes.Ver">
                                    <button class="btn btn-sm btn-outline-secondary me-1"
                                            @onclick="() => VerCtaCte(persona.Id)">
                                        <i class="bi bi-receipt"></i> Cta Cte
                                    </button>
                                </PermisoView>

                                <PermisoView Permiso="@Permisos.Personas.Editar">
                                    <button class="btn btn-sm btn-primary me-1"
                                            @onclick="() => EditarPersona(persona.Id)">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                </PermisoView>

                                <PermisoView Permiso="@Permisos.Personas.Eliminar">
                                    <button class="btn btn-sm btn-danger"
                                            @onclick="() => EliminarPersona(persona)">
                                        <i class="bi bi-trash3-fill"></i>
                                    </button>
                                </PermisoView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <!-- MOBILE: CARDS -->
        <div class="personas-cards-list">
            @foreach (var persona in PersonasFiltradas)
            {
                <div class="card persona-card shadow-sm mb-2">
                    <div class="card-body py-2">

                        <!-- Nombre / Razón social -->
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <div class="fw-semibold">
                                @if (!string.IsNullOrWhiteSpace(persona.RazonSocial))
                                {
                                    @persona.RazonSocial
                                }
                                else
                                {
                                    @($"{persona.Apellido}, {persona.Nombre}")
                                }
                            </div>

                            <span class="badge bg-secondary">
                                @FormatearCUITVista(persona.CUIT)
                            </span>
                        </div>

                        <!-- Datos secundarios -->
                        <div class="small text-muted">
                            DNI: <strong>@persona.DNI</strong>
                        </div>
                        <div class="small text-muted mb-1">
                            Celular: <strong>@persona.Celular</strong>
                        </div>

                        <!-- Acciones -->
                        <div class="mt-2 d-flex flex-wrap gap-1 justify-content-end">

                            <PermisoView Permiso="@Permisos.CuentasCorrientes.Ver">
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => VerCtaCte(persona.Id)">
                                    <i class="bi bi-receipt"></i> Cta Cte
                                </button>
                            </PermisoView>

                            <PermisoView Permiso="@Permisos.Personas.Editar">
                                <button class="btn btn-sm btn-primary"
                                        @onclick="() => EditarPersona(persona.Id)">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                            </PermisoView>

                            <PermisoView Permiso="@Permisos.Personas.Eliminar">
                                <button class="btn btn-sm btn-danger"
                                        @onclick="() => EliminarPersona(persona)">
                                    <i class="bi bi-trash3-fill"></i>
                                </button>
                            </PermisoView>

                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>
