    <div class="container mt-4 personas-page">
    <h3>👥 Personas</h3>

    @if (esMovil)
    {
        <!-- ====== MOBILE ====== -->
        <div class="mb-3">
            <PermisoView Permiso="@Permisos.Personas.Crear">
            <button class="btn btn-primary w-100 mb-2" @onclick="NuevaPersona">
                <i class="bi bi-person-add fs-5"></i> Nueva Persona
            </button>
            </PermisoView>
            <!-- Campo de búsqueda -->
            <input class="form-control mb-2"
                   placeholder="🔍 Buscar..."
                   @bind="FiltroBusqueda"
                   @bind:event="oninput" />

            <!-- Campo de tipo de búsqueda -->
            <select class="form-select mb-2" @bind="CampoBusqueda">
                <option value="General">Nombre / Apellido / Razón Social</option>
                <option value="Email">Email</option>
                <option value="Domicilio">Domicilio</option>
            </select>

            <!-- Filtro por tipo de persona -->
            <select class="form-select" @bind="FiltroTipoPersona">
                <option value="">Todas</option>
                @foreach (var tipo in Enum.GetValues<TipoPersona>())
                {
                    <option value="@tipo">@tipo</option>
                }
            </select>
        </div>
    }
    else
    {
        <!-- ====== DESKTOP ====== -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <PermisoView Permiso="@Permisos.Personas.Crear">
            <button class="btn btn-primary" @onclick="NuevaPersona">
                <i class="bi bi-person-add fs-5"></i> Nueva Persona
            </button>
            </PermisoView>
        </div>

        <div class="d-flex gap-2 mb-3">

            <!-- Camel selector -->
            <select class="form-select w-auto" @bind="CampoBusqueda">
                <option value="General">Nombre / Apellido / Razón Social</option>
                <option value="Email">Email</option>
                <option value="Domicilio">Domicilio</option>
            </select>

            <!-- Búsqueda -->
            <input class="form-control w-50"
                   placeholder="🔍 Buscar..."
                   @bind="FiltroBusqueda"
                   @bind:event="oninput" />

            <!-- Tipo persona -->
            <select class="form-select w-auto" @bind="FiltroTipoPersona">
                <option value="">Todas</option>
                @foreach (var tipo in Enum.GetValues<TipoPersona>())
                {
                    <option value="@tipo">@tipo</option>
                }
            </select>
        </div>
    }




