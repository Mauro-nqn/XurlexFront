@attribute [Authorize]

@page "/secretarias"
@inherits SecretariaBase
@layout AdminLayout

<div class="container mt-4">
    <h3>📂 Secretarías</h3>
    <button class="btn btn-success mb-3" @onclick="Nueva">➕ Nueva Secretaría</button>

    @if (Secretarias == null)
    {
        <p>Cargando...</p>
    }
    else if (!Secretarias.Any())
    {
        <p>No hay secretarías registradas.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Juzgado</th>
                    <th>Juez</th>
                    <th>Secretario</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Secretarias)
                {
                    <tr>
                        <td>@s.Nombre</td>
                        <td>@s.JuzgadoNombre</td>
                        <td>@s.Juez</td>
                        <td>@s.Secretario</td>
                        <td>
                            <button class="btn btn-primary btn-sm" @onclick="() => Editar(s.Id)">✏️ Editar</button>
                            <button class="btn btn-danger btn-sm ms-2" @onclick="() => Eliminar(s.Id)">🗑️ Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
