    <h5 class="mt-4">Movimientos</h5>

    @if (!esMovil)   @* mismo flag que venimos usando *@
    {
        <table class="table table-striped table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th>Detalle</th>
                    <th class="text-end">Importe</th>
                    <th class="text-end">Saldo</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Movimientos.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">Sin movimientos.</td>
                    </tr>
                }
                else
                {
                    @foreach (var m in MovimientosOrdenados)
                    {
                        <tr>
                            <td>@m.Mov.Fecha?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(m.Mov.Tipo == TipoMovimientoCuenta.Debito ? "Débito" : "Crédito")</td>
                            <td>
                                @m.Mov.Detalle

                                @if (m.Mov.OrigenTipo == OrigenMovimientoCuenta.Reversa)
                                {
                                    <span class="badge text-bg-warning ms-2">Reversa</span>
                                }
                            </td>

                            <td class="text-end">@((m.Mov.Importe ?? 0).ToString("C"))</td>
                            <td class="text-end">@m.Running.ToString("C")</td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center flex-wrap gap-1">
                                    <PermisoView Permiso="@Permisos.Recibos.Reversa">
                                        @if (m.Mov.OrigenTipo == OrigenMovimientoCuenta.Reversa)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-warning me-1"
                                                    @onclick="() => DeshacerAnulacionDesdeCtaCte(m.Mov.Id)">
                                                🔓 Deshacer reversa
                                            </button>
                                        }
                                    </PermisoView>

                                    @if (EsReciboActivo(m.Mov))
                                    {
                                        <PermisoView Permiso="@Permisos.Recibos.Ver">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary me-2"
                                                    @onclick="() => VerRecibo(m.Mov.OrigenId!.Value)">
                                                <i class="bi bi-eyeglasses"></i> Ver
                                            </button>
                                        </PermisoView>
                                        <PermisoView Permiso="@Permisos.Recibos.Editar">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary me-2"
                                                    @onclick="() => EditarRecibo(m.Mov.OrigenId!.Value)">
                                                <i class="bi bi-pencil-fill"></i> Recibo
                                            </button>
                                        </PermisoView>
                                        <PermisoView Permiso="@Permisos.Recibos.Eliminar">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => EliminarRecibo(m.Mov.OrigenId!.Value)">
                                                <i class="bi bi-trash3-fill"></i>
                                            </button>
                                        </PermisoView>
                                    }

                                    @if (m.Mov.OrigenTipo == OrigenMovimientoCuenta.Factura && m.Mov.OrigenId.HasValue)
                                    {
                                        <PermisoView Permiso="@Permisos.Facturas.Ver">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary me-2"
                                                    @onclick="() => VerFactura(m.Mov.OrigenId.Value)">
                                                <i class="bi bi-receipt"></i> Ver factura
                                            </button>
                                        </PermisoView>

                                        <PermisoView Permiso="@Permisos.Facturas.Eliminar">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => EliminarMovimientoCuentaAsync(m.Mov.Id)">
                                                <i class="bi bi-trash3-fill"></i>
                                            </button>
                                        </PermisoView>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
    else
    {
        <!-- 📱 MOBILE: movimientos como cards -->
        @if (Movimientos.Count == 0)
        {
            <div class="text-center text-muted py-3">Sin movimientos.</div>
        }
        else
        {
            <div class="cta-movimientos-cards">
                @foreach (var m in MovimientosOrdenados)
                {
                    var tipoTexto = m.Mov.Tipo == TipoMovimientoCuenta.Debito ? "Débito" : "Crédito";
                    var importeTexto = (m.Mov.Importe ?? 0).ToString("C");
                    var saldoTexto = m.Running.ToString("C");

                    <div class="card cta-mov-card shadow-sm mb-2">
                        <div class="card-body">
                            <!-- Fecha + tipo + importe -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <div class="text-muted small">
                                        @m.Mov.Fecha?.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                    <div class="small">
                                        <strong>Tipo:</strong> @tipoTexto
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="small text-muted">Importe</div>
                                    <div class="fw-bold cta-mov-importe">
                                        @importeTexto
                                    </div>
                                </div>
                            </div>

                            <!-- Detalle + badge Reversa -->
                            <div class="small mb-2">
                                <strong>Detalle:</strong>
                                <span class="ms-1">@m.Mov.Detalle</span>

                                @if (m.Mov.OrigenTipo == OrigenMovimientoCuenta.Reversa)
                                {
                                    <span class="badge text-bg-warning ms-2">Reversa</span>
                                }
                            </div>

                            <!-- Saldo -->
                            <div class="small mb-2">
                                <strong>Saldo:</strong>
                                <span class="ms-1">@saldoTexto</span>
                            </div>



                            <!-- Acciones -->
                            <div class="d-flex flex-column flex-sm-row flex-wrap gap-2 mt-2">
                                <PermisoView Permiso="@Permisos.Recibos.Reversa">
                                    @if (m.Mov.OrigenTipo == OrigenMovimientoCuenta.Reversa)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-warning flex-fill"
                                                @onclick="() => DeshacerAnulacionDesdeCtaCte(m.Mov.Id)">
                                            🔓 Deshacer reversa
                                        </button>
                                    }
                                </PermisoView>

                                @if (EsReciboActivo(m.Mov))
                                {
                                    <PermisoView Permiso="@Permisos.Recibos.Ver">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary flex-fill"
                                                @onclick="() => VerRecibo(m.Mov.OrigenId!.Value)">
                                            <i class="bi bi-eyeglasses"></i> Ver
                                        </button>
                                    </PermisoView>
                                    <PermisoView Permiso="@Permisos.Recibos.Editar">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary flex-fill"
                                                @onclick="() => EditarRecibo(m.Mov.OrigenId!.Value)">
                                            <i class="bi bi-pencil-fill"></i> Recibo
                                        </button>
                                    </PermisoView>
                                    <PermisoView Permiso="@Permisos.Recibos.Eliminar">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger flex-fill"
                                                @onclick="() => EliminarRecibo(m.Mov.OrigenId!.Value)">
                                            <i class="bi bi-trash3-fill"></i>
                                        </button>
                                    </PermisoView>
                                }

                                @if (m.Mov.OrigenTipo == OrigenMovimientoCuenta.Factura && m.Mov.OrigenId.HasValue)
                                {
                                    <PermisoView Permiso="@Permisos.Facturas.Ver">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary flex-fill"
                                                @onclick="() => VerFactura(m.Mov.OrigenId.Value)">
                                            <i class="bi bi-receipt"></i> Ver factura
                                        </button>
                                    </PermisoView>

                                    <PermisoView Permiso="@Permisos.Facturas.Eliminar">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger flex-fill"
                                                @onclick="() => EliminarMovimientoCuentaAsync(m.Mov.Id)">
                                            <i class="bi bi-trash3-fill"></i>
                                        </button>
                                    </PermisoView>
                                }


                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }


