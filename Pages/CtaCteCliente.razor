@{
    bool EsReciboActivo(MovimientoCuentaDto mov) =>
        mov.OrigenTipo == OrigenMovimientoCuenta.Recibo
        && mov.OrigenId.HasValue
        && !RecibosReversados.Contains(mov.OrigenId.Value);

    // bool EsPresupuestoReversado(MovimientoCuentaDto mov) =>
