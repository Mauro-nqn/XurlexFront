        <div class="d-flex flex-column flex-sm-row gap-2 cta-cte-actions">
            @if (Cuenta is null)
            {
                <PermisoView Permiso="@Permisos.CuentasCorrientes.Crear">
                    <button class="btn btn-success w-100 w-sm-auto"
                            @onclick="ToggleCrearCuenta">
                        <i class="bi bi-plus-lg"></i> Crear Cta Corriente
                    </button>
                </PermisoView>
            }
            else
            {
                <button class="btn btn-outline-secondary w-100 w-sm-auto"
                        @onclick="Refrescar">
                    <i class="bi bi-arrow-clockwise"></i> Actualizar
                </button>

                <PermisoView Permiso="@Permisos.CuentasCorrientes.Editar">
                    <button class="btn btn-outline-secondary w-100 w-sm-auto"
                            @onclick="ToggleEditarCuenta">
                        <i class="bi bi-gear"></i> Editar cuenta
                    </button>
                </PermisoView>

                <PermisoView Permiso="@Permisos.Recibos.Crear">
                    <button class="btn btn-primary w-100 w-sm-auto"
                            @onclick="AbrirRecibo">
                        <i class="bi bi-plus-lg"></i> Nuevo Recibo
                    </button>
                </PermisoView>
            }
        </div>

    </div>

    @if (Cuenta is not null && MostrarEditarCuenta)
{
    <EditForm Model="@CuentaEdicion" OnValidSubmit="ConfirmarEditarCuenta" class="card shadow-sm p-3 mb-3">
        <div class="row g-3 align-items-end">
            <div class="col-auto">
                <div class="form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="CuentaEdicion.Activa" />
                    <label class="form-check-label ms-2">Activa</label>
                </div>
            </div>
            <div class="col-auto">
                <label class="form-label">Límite de crédito</label>
                <InputNumber TValue="decimal?" class="form-control" @bind-Value="CuentaEdicion.LimiteCredito" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-success">💾 Guardar</button>
                <button type="button" class="btn btn-outline-secondary ms-2" @onclick="ToggleEditarCuenta">Cancelar</button>
            </div>
        </div>
    </EditForm>
}

    @if (Cuenta is null)
    {
        <div class="alert alert-info mb-3">
            Este cliente aún no tiene cuenta corriente.
        </div>

        @if (MostrarFormCrearCuenta)
        {
            <EditForm Model="@CuentaNueva" OnValidSubmit="ConfirmarCrearCuenta" class="card shadow-sm crear-cta-form">
                <DataAnnotationsValidator />
                <div class="card-body">
                    <h5 class="card-title">Crear Cuenta Corriente</h5>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Fecha de apertura</label>
                            <InputDate class="form-control" @bind-Value="CuentaNueva.FechaApertura" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Saldo de apertura</label>
                            <InputNumber class="form-control" @bind-Value="CuentaNueva.SaldoApertura" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Límite de crédito (opcional)</label>
                            <InputNumber class="form-control" @bind-Value="CuentaNueva.LimiteCredito" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check">
                                <InputCheckbox id="activa" class="form-check-input" @bind-Value="CuentaNueva.Activa" />
                                <label class="form-check-label ms-2" for="activa">Activa</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-success">✅ Confirmar</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="ToggleCrearCuenta">Cancelar</button>
                    </div>
                </div>
            </EditForm>
        }
    }





    @if (Cuenta is not null)
    
    {

        <div class="row mb-3 resume-cards">
            <div class="col-md-4">
                <div class="card text-bg-light">
                    <div class="card-body">
                        <div class="card-title">Débitos</div>
                        <div class="h4">@DebitosTotal.ToString("C")</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-bg-light">
                    <div class="card-body">
                        <div class="card-title">Créditos</div>
                        <div class="h4">@CreditosTotal.ToString("C")</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card @(Saldo >= 0 ? "text-bg-success" : "text-bg-danger")">
                    <div class="card-body">
                        <div class="card-title">Saldo</div>
                        <div class="h4">@Saldo.ToString("C")</div>
                    </div>
                </div>
            </div>
        </div>







        <div class="row g-2 mt-1 info-strip align-items-center">
            <div class="col-auto">
                <span class="stat-pill">
                    <span class="label">Límite:</span>
                    <span class="value">@((LimiteCredito.HasValue ? LimiteCredito.Value.ToString("C") : "Sin límite"))</span>
                </span>
            </div>
            <div class="col-auto">
                <span class="stat-pill">
                    <span class="label">Deuda actual:</span>
                    <span class="value">@DeudaActual.ToString("C")</span>
                </span>
            </div>
            <div class="col-auto">
                <span class="stat-pill @(DisponibleCredito.HasValue && DisponibleCredito.Value < 0 ? "neg" : "pos")">
                    <span class="label">Crédito disp.:</span>
                    <span class="value">@((DisponibleCredito.HasValue ? DisponibleCredito.Value.ToString("C") : "—"))</span>
                </span>
            </div>
            <div class="col-auto">
                <span class="stat-pill">
                    <span class="label">Estado:</span>
                    <span class="value">@((Cuenta.Activa ? "Activa" : "Inactiva"))</span>
                </span>
            </div>
            <div class="col-auto">
                <span class="stat-pill">
                    <span class="label">Apertura:</span>
                    <span class="value">
                        @(Cuenta.FechaApertura.HasValue
                                            ? Cuenta.FechaApertura.Value.ToLocalTime().ToString("dd/MM/yyyy")
                                            : "-")
                </span>
                </span>
            </div>
        </div>




    }
    

    @if (Cuenta is null)
    {
        <div class="alert alert-info">
            Este cliente aún no tiene cuenta corriente. Creala para registrar movimientos.
        </div>
    }
 
