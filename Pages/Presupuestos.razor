                    </table>
                </div>
            }
            else
            {
                <!-- ====== MOBILE: CARDS ====== -->
                @if (Presupuestos.Count == 0)
                {
                    <p class="text-center text-muted mt-3">No hay presupuestos registrados.</p>
                }
                else
                {
                    <div class="mt-2">
                        @foreach (var p in Presupuestos)
                        {
                            <div class="card shadow-sm mb-2 presupuesto-card">
                                <div class="card-body py-2">

                                    <!-- Fecha + Estado -->
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="badge bg-secondary">
                                            @p.Fecha.ToString("dd/MM/yyyy")
                                        </span>

                                        <span class="badge @(p.Estado == EstadoPresupuesto.Presupuestado ? "bg-warning" : "bg-success")">
                                            @p.Estado
                                        </span>
                                    </div>

                                    <!-- Cliente -->
                                    <div class="fw-semibold text-truncate" title="@(p.Persona?.RazonSocial ?? $"{p.Persona?.Apellido}, {p.Persona?.Nombre}")">
                                        @if (p.Persona != null)
                                        {
                                            if (!string.IsNullOrWhiteSpace(p.Persona.RazonSocial))
                                            {
                                                @p.Persona.RazonSocial
                                            }
                                            else
                                            {
                                                @($"{p.Persona.Apellido}, {p.Persona.Nombre}")
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin persona</span>
                                        }
                                    </div>

                                    <!-- Total -->
                                    <div class="small mb-1">
                                        Total: <strong>@p.Total.ToString("C")</strong>
                                    </div>

                                    <!-- Ajuste -->
                                    <div class="small mb-2">
                                        Ajuste:
                                        @switch (p.AjusteEstado)
                                        {
                                            case AjusteEstadoPresupuesto.AlDia:
                                                <span class="badge bg-success ms-1" title="Actualizado (Al día)">✔ Al día</span>
                                                break;

                                            case AjusteEstadoPresupuesto.Desfasado:
                                                <span class="badge bg-warning text-dark ms-1" title="Desactualizado">⚠ Desactualizado</span>
                                                break;

                                            case AjusteEstadoPresupuesto.SinVariable:
                                        <span class="badge bg-secondary ms-1" title="Sin Variable">🛇 Sin variable</span>
                                                break;
                                        }
                                    </div>

                                    <!-- Acciones -->
                                    <div class="d-flex flex-wrap gap-2 mt-1 justify-content-end">
                                        <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => Ver(p.Id)">
                                            👁
                                        </button>

                                        <button class="btn btn-sm btn-info"
                                                @onclick="() => Editar(p.Id)">
                                            ✏️
                                        </button>

                                        @if (p.Estado == EstadoPresupuesto.FacturadoParcial || p.Estado == EstadoPresupuesto.FacturadoTotal)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary"
                                                    @onclick="() => VerFacturasRelacionadas(p.Id)">
                                                🧾
                                            </button>
                                        }

                                        <button class="btn btn-sm btn-danger"
                                                disabled="@(!PuedeEliminar(p))"
                                                title="@(PuedeEliminar(p) ? null : MotivoBloqueoEliminar(p))"
                                                @onclick="() => Eliminar(p.Id)">
                                            🗑️
                                        </button>
                                    </div>

                                </div>
                            </div>
                        }
                    </div>
                }
            }

   @*      </table>
    </div> *@

    @if (MostrarModalFacturas)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,.5);">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Facturas del presupuesto #@PresupuestoIdSeleccionado</h5>
                        <button type="button" class="btn-close" @onclick="CerrarModalFacturas"></button>
                    </div>

                    <div class="modal-body">
                        @if (CargandoFacturas)
                        {
                            <div class="text-center text-muted my-3">Cargando…</div>
                        }
                        else if (FacturasRelacionadas.Count == 0)
                        {
                            <div class="text-center text-muted my-3">No hay facturas relacionadas.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>ID</th>
                                            <th>Pto. Vta</th>
                                            <th>Número</th>
                                            <th>Tipo</th>
                                            <th>Fecha</th>
                                            <th>CbteTipo</th>
                                            <th class="text-end">Total</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var f in FacturasRelacionadas)
                                        {
                                            <tr>
                                                <td>@f.FacturaId</td>
                                                <td>@(f.PuntoVenta ?? "-")</td>
                                                <td>@(f.Numero ?? "-")</td>
                                                <td>@(f.TipoComprobante ?? "-")</td>
                                                <td class="text-nowrap">@f.Fecha.ToString("dd/MM/yyyy")</td>
                                                <td>@(f.CbteTipo ?? "-")</td>
                                                <td class="text-end text-nowrap">@f.Total.ToString("C")</td>
@*                                                 <td class="text-end">
                                                    <button class="btn btn-sm btn-outline-primary" title="Abrir factura" @onclick="() => AbrirFactura(f.FacturaId)">Abrir</button>
                                                </td> *@

                                                <td class="text-end">
                                                    <button class="btn btn-sm btn-outline-primary"
                                                            title="Abrir factura"
                                                            @onclick="() => AbrirFacturaPreview(f.FacturaId)">
                                                        Abrir
                                                    </button>
                                                </td>

                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CerrarModalFacturas">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
    }




