                <div class="col-12 col-md-3">
                    <label class="form-label">Desde</label>
                    <InputDate class="form-control" @bind-Value="FiltroDesde" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label">Hasta</label>
                    <InputDate class="form-control" @bind-Value="FiltroHasta" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label">Cliente</label>
                    <InputSelect class="form-control" @bind-Value="FiltroPersonaId">
                        <option value="">— Todos —</option>
                        @foreach (var c in Personas)
                        {
                            <option value="@c.Id">
                                @(string.IsNullOrWhiteSpace(c.RazonSocial) ? $"{c.Apellido}, {c.Nombre}" : c.RazonSocial)
                            </option>
                        }
                    </InputSelect>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label">Estado</label>
                    <InputSelect class="form-control" @bind-Value="FiltroEstado">
                        <option value="">— Todos —</option>
                        @foreach (var e in Enum.GetValues<EstadoPresupuesto>())
