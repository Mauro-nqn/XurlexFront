                            <tr>
                                <th class="text-nowrap">Fecha</th>
                                <th class="minw-220">Cliente</th>
                                <th class="text-end text-nowrap">Total</th>
                                <th class="text-center text-nowrap">Ajuste</th>
                                <th class="text-end text-nowrap">Estado</th>
                                <th class="text-end minw-200">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Presupuestos.Count == 0)
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted">
                                        No hay presupuestos registrados.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var p in Presupuestos)
                                {
                                    <tr>
                                        <td class="text-nowrap">@p.Fecha.ToString("dd/MM/yyyy")</td>

                                        <td class="text-truncate maxw-280"
                                            title="@(p.Persona?.RazonSocial ?? $"{p.Persona?.Apellido}, {p.Persona?.Nombre}")">
                                            @if (p.Persona != null)
                                            {
                                                if (!string.IsNullOrWhiteSpace(p.Persona.RazonSocial))
                                                {
                                                    @p.Persona.RazonSocial
                                                }
                                                else
                                                {
                                                    @($"{p.Persona.Apellido}, {p.Persona.Nombre}")
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">Sin persona</span>
                                            }
                                        </td>

                                        <td class="text-end text-nowrap">
                                            <strong>@p.Total.ToString("C")</strong>
                                        </td>

                                        <td class="text-center text-nowrap">
                                            @switch (p.AjusteEstado)
                                            {
                                                case AjusteEstadoPresupuesto.AlDia:
                                                    <span class="badge bg-success badge-clickable" title="Actualizado (Al día)">✔A</span>
                                                    break;

                                                case AjusteEstadoPresupuesto.Desfasado:
                                                    <span class="badge bg-warning text-dark badge-clickable" title="Desactualizado">⚠D</span>
                                                    break;

                                                case AjusteEstadoPresupuesto.SinVariable:
                                            <span class="badge bg-secondary badge-clickable" title="Sin Variable">🛇SV</span>
                                                    break;
                                            }
                                        </td>

                                        <td class="text-end text-nowrap">
                                            <span class="badge @(p.Estado == EstadoPresupuesto.Presupuestado ? "bg-warning" : "bg-success")">
                                                @p.Estado
                                            </span>
                                        </td>

                                        <td class="text-end">
                                            <!-- Desktop/Tablet -->
                                            <div class="d-none d-md-inline-flex btn-group btn-group-sm" role="group">
                                                <button class="btn btn-outline-primary" title="Ver" @onclick="() => Ver(p.Id)">👁 Ver</button>
                                                <button class="btn btn-info" title="Editar" @onclick="() => Editar(p.Id)">✏️ Editar</button>

                                                @if (p.Estado == EstadoPresupuesto.FacturadoParcial || p.Estado == EstadoPresupuesto.FacturadoTotal)
                                                {
                                                    <button class="btn btn-outline-secondary"
                                                            title="Facturas"
                                                            @onclick="() => VerFacturasRelacionadas(p.Id)">
                                                        🧾 Facturas
                                                    </button>
                                                }

                                                <button class="btn btn-sm btn-danger"
                                                        disabled="@(!PuedeEliminar(p))"
                                                        title="@(PuedeEliminar(p) ? null : MotivoBloqueoEliminar(p))"
                                                        @onclick="() => Eliminar(p.Id)">
                                                    🗑️ Eliminar
                                                </button>
                                            </div>

                                            <!-- Mobile -->
                                            <div class="dropdown d-inline d-md-none">
                                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                        type="button"
                                                        data-bs-toggle="dropdown"
                                                        aria-expanded="false">
                                                    Acciones
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <li>
                                                        <a class="dropdown-item"
                                                           href="javascript:void(0)"
                                                           @onclick="() => Ver(p.Id)">
                                                            👁 Ver
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item"
