                            Vista previa factura #@FacturaIdPreview
                        </h5>
                        <button type="button" class="btn-close" @onclick="CerrarPreviewFactura"></button>
                    </div>

                    <div class="modal-body p-0">
                        <iframe src="@($"/facturas/impresion/{FacturaIdPreview}")"
                                class="w-100"
                                style="height: 75vh; border: none;"></iframe>
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CerrarPreviewFactura">
                            Cerrar
                        </button>

                        <a class="btn btn-primary"
                           target="_blank"
                           href="@($"/facturas/impresion/{FacturaIdPreview}")">
                            Abrir en pestaña nueva
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

</div>
