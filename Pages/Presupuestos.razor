                                                        <li>
                                                            <a class="dropdown-item"
                                                               href="javascript:void(0)"
                                                               @onclick="() => VerFacturasRelacionadas(p.Id)">
                                                                🧾 Facturas
                                                            </a>
                                                        </li>
                                                    }

                                                    <li><hr class="dropdown-divider" /></li>

                                                    @if (p.Estado is EstadoPresupuesto.Presupuestado or EstadoPresupuesto.Cancelado)
                                                    {
                                                        <li>
