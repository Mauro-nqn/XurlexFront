        @if (LicenciaCargando)
        {
            <div class="text-center mt-2">
                Verificando licencia…
            </div>
        }
        else
        {
            @* Info de la licencia *@
            @if (LicenciaEstudioVisible)
            {
                <label class="d-block text-center fw-bold" style="margin-top:5px">
                    @LicenciaEstudioTexto
                </label>
            }

            @if (LicenciaInfoVisible)
            {
                <label class="d-block text-center fw-bold" style="color:@LicenciaInfoColor">
                    @LicenciaInfoTexto
                </label>
            }

            <div class="mt-4">
                <button class="btn btn-primary w-100 mt-3"
                        style="margin-top:20px"
                        @onclick="OnLoginClicked"
                        disabled="@(!PuedeIniciarSesion)">
                    Iniciar Sesión
                </button>
            </div>

            <div class="text-danger text-center mt-2">@Mensaje</div>

            @*  Botón para mostrar el uploader SOLO cuando la licencia está vigente/por vencer *@
            @if (!MostrarUploaderLicencia && !MostrarUploaderManual && PuedeIniciarSesion)
            {
                <div class="text-center mt-3">
                    <button class="btn btn-link text-decoration-none"
                            style="font-size: 0.9rem"
                            @onclick="() => MostrarUploaderManual = true">
                        <i class="bi bi-lock-fill"></i> Cargar nueva licencia
                    </button>
                </div>
            }

            @* Uploader: se muestra si la licencia está vencida/sin licencia o si el usuario lo pidió manualmente *@
            @if (MostrarUploaderLicencia || MostrarUploaderManual)
            {
                <div class="mt-3 text-center">
                    <InputFile OnChange="OnLicenciaSeleccionada" accept=".lic" />

                    @if (!string.IsNullOrEmpty(LicenciaUploadMensaje))
                    {
                        <div class="text-center mt-2">@LicenciaUploadMensaje</div>
                    }

                    @if (MostrarUploaderManual && PuedeIniciarSesion)
                    {
                        <button class="btn btn-sm btn-outline-secondary mt-2"
                                @onclick="() => MostrarUploaderManual = false">
                            Cancelar
                        </button>
                    }
                </div>
            }
        }



        
    </div>
</div>



