<div class="login-page" style="background-image: url('/images/fondos/@FondoSeleccionado');">
    <!-- Logo inferior derecho con marco -->
    <div class="logo-bottom-right">
        <img src="images/xurlexconslogan.png" class="logo-frame" />
    </div>

    <!-- Logo inferior izquierdo -->
    <img src="images/xurdevbn.png" class="logo-bottom-left" />

    <!-- Contenedor centrado -->
    <div class="login-container card shadow">
        <h3 class="text-center mb-4" style="margin-top:10px">Inicio de Sesión</h3>

        <input @bind="Usuario" @bind:event="oninput" placeholder="Nombre de Usuario" class="form-control mb-2" />
        
        @* <input @bind="Password" type="password" placeholder="Contraseña" class="form-control mb-3" @onkeydown="HandleEnter" /> *@


        <div class="input-group mb-3">
            <input @bind="Password"
                   @bind:event="oninput"
                   type="@PasswordInputType"
                   placeholder="Contraseña"
                   class="form-control"
                   @onkeydown="HandleEnter" />

            <button type="button" class="btn btn-outline-secondary" @onclick="TogglePasswordVisibility">
                <i class="@EyeIconClass"></i>
            </button>
        </div>


