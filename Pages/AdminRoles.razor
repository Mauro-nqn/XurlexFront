@page "/admin/roles"
@using IurixBlazor.Services
@using IurixBlazor.Shared.Dtos
@inject RolService RolService


@inherits AdminRolesBase
@layout AdminLayout
<PageTitle>Roles – XurLex</PageTitle>
<h3>Administración de Roles y Permisos</h3>

<div class="row">
    <div class="col-md-4">
        <h5>Roles</h5>
        <PermisoView Permiso="@Permisos.Roles.Crear">
        <button class="btn btn-sm btn-primary mb-2" @onclick="NuevoRol">
            <i class="bi bi-plus"></i> Nuevo rol
        </button>
        </PermisoView>

        <ul class="list-group">
            @foreach (var r in Roles)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center
                               @(RolSeleccionado?.Id == r.Id ? "active" : "")"
                    @onclick="@(() => SeleccionarRol(r))">
                    <span>@r.Nombre</span>
                </li>
            }
        </ul>
    </div>

    <div class="col-md-8">
        @if (RolSeleccionado is null)
        {
            <p>Seleccione un rol para editar.</p>
        }
        else
        {
            <EditForm Model="@RolSeleccionado" OnValidSubmit="GuardarRol">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label">Nombre del rol</label>
                    <InputText class="form-control" @bind-Value="RolSeleccionado.Nombre" />
                </div>

                <h5>Permisos</h5>

                @foreach (var grupo in PermisosPorModulo)
                {
                    <div class="card mb-2">
                        <div class="card-header">
                            <strong>@grupo.Key</strong>
                        </div>
                        <div class="card-body">
                            @foreach (var p in grupo.Value)
                            {
                                var checkedValue = RolSeleccionado.Permisos.Contains(p.Codigo);

                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           checked="@checkedValue"
                                           @onchange="(e => TogglePermiso(p.Codigo, (bool)e.Value))" />
                                    <label class="form-check-label">
                                        <strong>@p.Codigo</strong> - @p.Descripcion
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                }

                <PermisoView Permiso="@Permisos.Roles.Editar">
                <button type="submit" class="btn btn-success me-2">
                    <i class="bi bi-save"></i> Guardar
                </button>
                </PermisoView>

                @if (RolSeleccionado.Id != 0)
                {
                    <PermisoView Permiso="@Permisos.Roles.Eliminar">
                    <button class="btn btn-danger" @onclick="EliminarRol">
                        <i class="bi bi-trash"></i> Eliminar
                    </button>
                    </PermisoView>
                }
            </EditForm>
        }
    </div>
</div>

