@attribute [Authorize]

@page "/puntos-venta"
@inherits PuntoVentaBase
@layout AdminLayout

<div class="container mt-4 puntos-venta-container">
    <h3>🏪 Puntos de Venta</h3>

    <button class="btn btn-primary mb-3" @onclick="NuevoPunto">➕ Nuevo Punto</button>

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Número</th>
                <th>Descripción</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Puntos.Count == 0)
            {
                <tr><td colspan="3" class="text-center text-muted">No hay puntos de venta registrados.</td></tr>
            }
            else
            {
                @foreach (var pv in Puntos)
                {
                    <tr>
                        <td>@pv.Numero</td>
                        <td>@pv.Descripcion</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-info me-2" @onclick="() => Editar(pv.Id)">✏️ Editar</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => Eliminar(pv.Id)">🗑️ Eliminar</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
