@attribute [Authorize]

@page "/config/estudio"
@layout AdminLayout
@inherits EstudioConfigBase

<div class="container mt-4 estudio-config">
    <h3>🏛️ Configuración del Estudio</h3>

    @if (Cargando)
    {
        <div class="alert alert-info mt-3">Cargando...</div>
    }
    else if (Error != null)
    {
        <div class="alert alert-danger mt-3">@Error</div>
    }
    else
    {
        @if (!Existe)
        {
            <div class="alert alert-warning mt-3">
                No hay configuración inicial. Creá el registro.
            </div>

            <EditForm Model="CrearDto" OnValidSubmit="Crear" class="card p-3 mt-3">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nombre *</label>
                        <InputText class="form-control" @bind-Value="CrearDto.Nombre" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Teléfono</label>
                        <InputText class="form-control" @bind-Value="CrearDto.Telefono" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <InputText class="form-control" @bind-Value="CrearDto.Email" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Web</label>
                        <InputText class="form-control" @bind-Value="CrearDto.Web" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Domicilio</label>
                        <InputText class="form-control" @bind-Value="CrearDto.Domicilio" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">CUIT</label>
                        <InputText class="form-control" @bind-Value="CrearDto.Cuit" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Provincia</label>
                        <InputText class="form-control" @bind-Value="CrearDto.Provincia" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Localidad</label>
                        <InputText class="form-control" @bind-Value="CrearDto.Localidad" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Observaciones</label>
                        <InputTextArea class="form-control" @bind-Value="CrearDto.Observaciones" rows="3" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Logo (archivo)</label>
                        <InputFile OnChange="OnLogoFileChangeCrear" />
                        @if (!string.IsNullOrWhiteSpace(CrearDto.LogoBase64))
                        {
                            <div class="logo-preview mt-2">
                                <img src="@($"data:image/png;base64,{CrearDto.LogoBase64}")" alt="Logo" />
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-3 d-flex gap-2">
                    <button class="btn btn-success" type="submit">💾 Crear</button>
                    <button class="btn btn-secondary" type="button" @onclick="Recargar">↻ Recargar</button>
                </div>
            </EditForm>
        }
        else
        {
            <div class="card p-3 mt-3">
                @if (!Editando)
                {
                    <div class="row g-3">
                        <div class="col-md-8">
                            <div><b>Nombre:</b> @Vista!.Nombre</div>
                            <div><b>Domicilio:</b> @Vista.Domicilio</div>
                            <div><b>Teléfono:</b> @Vista.Telefono</div>
                            <div><b>Email:</b> @Vista.Email</div>
                            <div><b>Web:</b> @Vista.Web</div>
                            <div><b>CUIT:</b> @Vista.Cuit</div>
                            <div><b>Provincia:</b> @Vista.Provincia</div>
                            <div><b>Localidad:</b> @Vista.Localidad</div>
                            <div><b>Observaciones:</b> @Vista.Observaciones</div>
                            <div class="text-muted mt-2"><small>Actualizado: @Vista.UpdatedAt.ToLocalTime()</small></div>
                        </div>
                        <div class="col-md-4">
                            <div class="logo-preview">
                                @if (!string.IsNullOrWhiteSpace(Vista.LogoBase64))
                                {
                                    <img src="@($"data:image/png;base64,{Vista.LogoBase64}")" alt="Logo" />
                                }
                                else
                                {
                                    <div class="text-muted">Sin logo</div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="mt-3 d-flex gap-2">
                        <button class="btn btn-primary" @onclick="HabilitarEdicion">✏️ Editar</button>
                        <button class="btn btn-secondary" @onclick="Recargar">↻ Recargar</button>
                    </div>
                }
                else
                {
                    <EditForm Model="PatchDto" OnValidSubmit="Guardar" class="mt-1">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Nombre</label>
                                <InputText class="form-control" @bind-Value="PatchDto.Nombre" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Teléfono</label>
                                <InputText class="form-control" @bind-Value="PatchDto.Telefono" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email</label>
                                <InputText class="form-control" @bind-Value="PatchDto.Email" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Web</label>
                                <InputText class="form-control" @bind-Value="PatchDto.Web" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Domicilio</label>
                                <InputText class="form-control" @bind-Value="PatchDto.Domicilio" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">CUIT</label>
                                <InputText class="form-control" @bind-Value="PatchDto.Cuit" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Provincia</label>
                                <InputText class="form-control" @bind-Value="PatchDto.Provincia" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Localidad</label>
                                <InputText class="form-control" @bind-Value="PatchDto.Localidad" />
                            </div>

                            <div class="col-12">
                                <label class="form-label">Observaciones</label>
                                <InputTextArea class="form-control" @bind-Value="PatchDto.Observaciones" rows="3" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Logo (archivo)</label>
                                <InputFile OnChange="OnLogoFileChangePatch" />
                                @if (!string.IsNullOrWhiteSpace(LogoPreviewBase64))
                                {
                                    <div class="logo-preview mt-2">
                                        <img src="@($"data:image/png;base64,{LogoPreviewBase64}")" alt="Logo" />
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="mt-3 d-flex gap-2">
                            <button class="btn btn-success" type="submit">💾 Guardar</button>
                            <button class="btn btn-secondary" type="button" @onclick="CancelarEdicion">Cancelar</button>
                        </div>
                    </EditForm>
                }
            </div>
        }
    }
</div>
