@attribute [Authorize]
@page "/procesos/listado"
@layout AdminLayout

<div class="container mt-4">

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">📋 Listado de Procesos</h3>
    <button class="btn btn-outline-secondary" @onclick="Limpiar">
      <i class="bi bi-eraser"></i> Limpiar
    </button>

        <button class="btn btn-outline-primary" @onclick="PrevisualizarPdf" disabled="@(!Items.Any())">
            <i class="bi bi-eye"></i> Previsualizar
        </button>

        <button class="btn btn-outline-danger" @onclick="ExportarPdf" disabled="@(!Items.Any())">
            <i class="bi bi-file-earmark-pdf"></i> PDF
        </button>
  </div>

  <!-- Filtros -->
  <div class="card mb-3">
    <div class="card-body">
      <div class="row g-2">

             

                    <!-- Tipo de Proceso (Judicial / Extrajudicial) -->
                    <div class="col-12 col-md-3">
                        <label class="form-label">Tipo de Proceso</label>
                        <select class="form-select"
                                value="@Filtro.TipoGestion"
                                @onchange="OnTipoGestionChanged">
                            <option value="">Todos</option>
                            <option value="Judicial">Judicial</option>
                            <option value="Extrajudicial">Extrajudicial</option>
                        </select>
                    </div>

                    <!-- Tipo Proceso (solo Judicial) -->
                    <div class="col-12 col-md-3">
                        <label class="form-label">Tipo Proceso (Judicial)</label>
                        <select class="form-select"
                                @bind="Filtro.TipoProcesoId"
                                disabled="@(Filtro.TipoGestion == "Extrajudicial")">
                            <option value="">Todos</option>
                            @foreach (var tp in TiposProceso)
                            {
                                <option value="@tp.Id">@tp.Nombre</option>
                            }
                        </select>
                    </div>


        <div class="col-12 col-md-3">
          <label class="form-label">Responsable</label>
          <select class="form-select" @bind="Filtro.ResponsableId">
            <option value="">Todos</option>
            @foreach (var u in Responsables)
            {
              <option value="@u.Id">@u.Nombre @u.Apellido</option>
            }
          </select>
        </div>

        <div class="col-12 col-md-3">
          <label class="form-label">Grupo</label>
          <select class="form-select" @bind="Filtro.GrupoId">
            <option value="">Todos</option>
            @foreach (var g in Grupos)
            {
              <option value="@g.Id">@g.Nombre</option>
            }
          </select>
        </div>


    @*     <div class="col-12 col-md-3">
          <label class="form-label">Tipo Proceso (Judicial)</label>
          <select class="form-select" @bind="Filtro.TipoProcesoId">
            <option value="">Todos</option>
            @foreach (var tp in TiposProceso)
            {
              <option value="@tp.Id">@tp.Nombre</option>
            }
          </select>
        </div> *@

        <div class="col-12 col-md-3">
          <label class="form-label">Jurisdicción</label>
          <select class="form-select" @bind="Filtro.JurisdiccionId">
            <option value="">Todas</option>
            @foreach (var j in Jurisdicciones)
            {
              <option value="@j.Id">@j.Nombre</option>
            }
          </select>
        </div>

        <div class="col-12 col-md-6">
          <label class="form-label">Carátula contiene</label>
          <input class="form-control" placeholder="Ej: 'Pérez'..."
                 @bind="Filtro.CaratulaContiene" />
        </div>

        <div class="col-12 col-md-6">
          <label class="form-label">Estados (múltiples)</label>
          <div class="border rounded p-2" style="max-height:120px; overflow:auto;">
            @foreach (var e in Estados)
            {
              <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       checked="@Filtro.EstadoIds.Contains(e.Id)"
                       @onchange="(ev) => ToggleEstado(e.Id, (bool)ev.Value!)" />
                <label class="form-check-label">@e.Nombre</label>
              </div>
            }
          </div>
        </div>

             @*    <div class="col-12 col-md-4">
                    <label class="form-label">Parte (contiene)</label>
                    <input class="form-control"
                           placeholder="Apellido, nombre o razón social..."
                           @bind="Filtro.ParteNombreContiene" />
                </div> *@

                <div class="col-12 col-md-4">
                    <label class="form-label">Persona (exacta)</label>
                    <div class="input-group">
                        <input class="form-control" placeholder="Buscar persona..."
                               @bind="PersonaQuery" />
                        <button class="btn btn-outline-secondary" type="button" @onclick="BuscarPersonas">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>

                    @if (PersonasEncontradas.Any())
                    {
                        <div class="list-group mt-1" style="max-height:160px; overflow:auto;">
                            @foreach (var p in PersonasEncontradas)
                            {
                                <button type="button" class="list-group-item list-group-item-action"
                                        @onclick="() => SeleccionarPersona(p)">
                                    @(!string.IsNullOrWhiteSpace(p.RazonSocial) ? p.RazonSocial : $"{p.Apellido}, {p.Nombre}")
                                </button>
                            }
                        </div>
                    }

                    @if (Filtro.PersonaParteId.HasValue)
                    {
                        <div class="small text-muted mt-1">
                            Seleccionada: @PersonaSeleccionadaNombre
                            <button class="btn btn-sm btn-link" @onclick="LimpiarPersona">Quitar</button>
                        </div>
                    }
                </div>

                <div class="col-12 col-md-4">
                    <label class="form-label">Carácter</label>
                    <select class="form-select" @bind="Filtro.CaracterIntervencionId">
                        <option value="">Cualquiera</option>
                        @foreach (var c in Caracteres)
                        {
                            <option value="@c.Id">@c.Nombre</option>
                        }
                    </select>
                </div>


      </div>

      <div class="mt-3 d-flex gap-2">
        <button class="btn btn-primary" @onclick="Buscar">
          <i class="bi bi-search"></i> Buscar
        </button>
      </div>
    </div>
  </div>

  <!-- Resultados -->
  @if (Cargando)
  {
    <div class="alert alert-info">Buscando...</div>
  }
  else if (!Items.Any())
  {
    <div class="alert alert-secondary">Sin resultados.</div>
  }
  else
  {
    <!-- Desktop: tabla -->
    <div class="d-none d-md-block">
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead>
            <tr>
              <th>Carátula</th>
              <th>Estado</th>
              <th>Responsable</th>
              <th>Grupo</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var it in Items)
            {
              <tr>
                <td>
                  <div class="fw-semibold">@it.Caratula</div>
                  <div class="text-muted small">@it.NumeroExpediente</div>
                </td>
                <td>@it.EstadoNombre</td>
                <td>@it.ResponsableNombre</td>
                <td>@it.GrupoNombre</td>
                <td class="text-end">
                  <button class="btn btn-sm btn-outline-primary"
                          @onclick="() => IrAGestion(it.GestionId)">
                    Ver
                  </button>
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>

    <!-- Mobile: cards -->
    <div class="d-md-none">
      @foreach (var it in Items)
      {
        <div class="card mb-2">
          <div class="card-body">
            <div class="fw-semibold">@it.Caratula</div>
            <div class="small text-muted">@it.NumeroExpediente</div>
            <div class="mt-2">
              <span class="badge bg-secondary">@it.EstadoNombre</span>
              <span class="ms-2 small">@it.ResponsableNombre</span>
            </div>
            <div class="mt-2 d-flex justify-content-end">
              <button class="btn btn-sm btn-outline-primary"
                      @onclick="() => IrAGestion(it.GestionId)">
                Ver
              </button>
            </div>
          </div>
        </div>
      }
    </div>

    <!-- Paginado simple -->
    <div class="d-flex justify-content-between align-items-center mt-3">
      <div class="text-muted small">
        Total: @Total
      </div>
      <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary btn-sm" disabled="@(Filtro.Page <= 1)" @onclick="Prev">Anterior</button>
        <button class="btn btn-outline-secondary btn-sm" disabled="@((Filtro.Page * Filtro.PageSize) >= Total)" @onclick="Next">Siguiente</button>
      </div>
    </div>
  }
</div>


@*Modal para previsualizar listados de procesos*@

<div class="modal fade" id="pdfPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Previsualización PDF</h5>

                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AbrirEnNuevaPestana">
                        <i class="bi bi-box-arrow-up-right"></i> Abrir
                    </button>

                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ImprimirPreview">
                        <i class="bi bi-printer"></i> Imprimir
                    </button>

                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"
                            @onclick="CerrarPreview"></button>
                </div>
            </div>

            <div class="modal-body p-0" style="height: 80vh;">
                <iframe id="pdfPreviewFrame"
                        style="width:100%; height:100%; border:0;"
                        src="@PdfPreviewUrl">
                </iframe>
            </div>
        </div>
    </div>
</div>
