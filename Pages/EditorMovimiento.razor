    private async Task DescartarBorrador()
    {
        var confirmar = await JS.InvokeAsync<bool>(
            "confirm",
            "Se eliminará el borrador local de este escrito. ¿Continuar?"
        );
        if (!confirmar) return;

        // 1) Borrar storage
        await LimpiarBorradorAsync();

        // 2) Pausar dirty en JS para que setData NO marque cambios
        await JS.InvokeVoidAsync("pauseEditorDirty", "editor1");

        // 3) Limpiar editor visible
        await JS.InvokeVoidAsync("setEditorContent", "editor1", "");

        // 4) Reanudar dirty
        await JS.InvokeVoidAsync("resumeEditorDirty", "editor1");

        // 5) Reset flags
        Titulo = "";
        _tieneCambios = false;

        await JS.InvokeVoidAsync("mostrarToast", "Borrador descartado.", "success");
        await InvokeAsync(StateHasChanged);


                

    }










    private async Task BuscarEscritos()
    {
        var resultado = await EscritoService.ObtenerEscritosAsync(1, 20, FiltroEscrito);
        Escritos = resultado.Items ?? new();
    }

    private async Task OnSeleccionarEscrito(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            EscritoSeleccionadoId = id;

            var escrito = await EscritoService.ObtenerEscritoPorIdAsync(id);
            if (escrito != null)
            {
                Titulo = escrito.Titulo;

                var base64 = ToBase64(escrito.ContenidoHtml);
                await JS.InvokeVoidAsync("initEditor", "editor1", base64);
            }
        }
    }

    private static string ToBase64(string plainText)
    {
        var bytes = Encoding.UTF8.GetBytes(plainText);
        return Convert.ToBase64String(bytes);
    }



    private async Task AbrirModalDemanda()
    {
        var gestionIdStr = await JS.InvokeAsync<string>("localStorage.getItem", "gestion_actual");

        if (int.TryParse(gestionIdStr, out var gid))
        {
            await IaModal.Abrir(gid);
        }
        else
        {
            await JS.InvokeVoidAsync("mostrarToast",
                "No se pudo determinar la gestión actual para generar la demanda.", "error");
        }
    }




