    {
        // borrador del escrito actual
        await JS.InvokeVoidAsync("localStorage.removeItem", DraftKey);
        await JS.InvokeVoidAsync("localStorage.removeItem", DraftTituloKey);

        // borrador residual de "nuevo"
        var draftNuevoKey = $"draft_escrito_g{(_gestionIdStr ?? "0")}_mnuevo";
        await JS.InvokeVoidAsync("localStorage.removeItem", draftNuevoKey);
        await JS.InvokeVoidAsync("localStorage.removeItem", draftNuevoKey + "_titulo");

        _hayBorrador = false;
        _borradorRestaurado = false;
    }







