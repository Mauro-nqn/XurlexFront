@attribute [Authorize]

@page "/editor-movimiento"
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject EscritoService EscritoService
@inject MovimientoService MovimientoService
@inject EditorInfoService EditorInfoService
@inject TipoProcesoService TipoProcesoService
@layout AdminLayout

@using IurixBlazor.Shared.Services
@using IurixBlazor.Pages
@using System.Text

@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable

<NavigationLock OnBeforeInternalNavigation="ConfirmarSalida" />

<div class="container mt-4">
    <h4>✍️ Editor de Movimiento</h4>
    <h5>Datos del Proceso: @DatosProcesoTexto </h5>

    <div class="d-flex mb-3">
        <input class="form-control me-2" placeholder="🔍 Buscar escrito..." @bind="FiltroEscrito" @oninput="BuscarEscritos" />
        <select class="form-select" @onchange="OnSeleccionarEscrito">
            <option value="">📄 Seleccionar escrito guardado</option>
            @foreach (var escrito in Escritos)
            {
                <option value="@escrito.Id">@escrito.Titulo</option>
            }
        </select>
    </div>

    <input class="form-control mb-2" placeholder="Título (opcional para guardar como escrito)" @bind="Titulo" />

    <textarea id="editor1" style="height: 400px;"></textarea>

    <div class="mt-3">
        <button class="btn btn-success me-2" @onclick="Guardar"><i class="bi bi-floppy2"></i> Guardar</button>
        <button class="btn btn-outline-primary me-2" @onclick="GuardarComoEscritoGlobal"><i class="bi bi-folder2"></i> Guardar modelo</button>
        @if (MostrarBotonDemanda)
        {
            <button class="btn btn-dark me-2" @onclick="AbrirModalDemanda">
                ⚡ Generar demanda ejecutiva (IA)
            </button>
        }


        <IaDemandaModal @ref="IaModal" OnDemandaGenerada="InsertarDemandaEnEditor" />

        <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>

        @if (_hayBorrador)
        {
            <button class="btn btn-outline-danger me-2"
                    @onclick="DescartarBorrador">
                🧹 Descartar borrador
            </button>
        }

    </div>

</div>

