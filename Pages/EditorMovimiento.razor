    private async Task Guardar()
    {

         // ✅ cortar autosave primero (evita que re-escriba borrador luego)
        try { await JS.InvokeVoidAsync("unbindEditorDirty", "editor1"); } catch { }


        var contenido = await JS.InvokeAsync<string>("getEditorContent", "editor1");

        // ❌ NO re-escribir el borrador acá (esto genera falsos positivos)
        // await JS.InvokeVoidAsync("localStorage.setItem", DraftKey, contenido);
        // await JS.InvokeVoidAsync("localStorage.setItem", DraftTituloKey, Titulo ?? "");

        await JS.InvokeVoidAsync("localStorage.setItem", "contenidoEditorMovimiento", contenido);
        await JS.InvokeVoidAsync("localStorage.setItem", "tituloEditorMovimiento", Titulo ?? "");

        await JS.InvokeVoidAsync("localStorage.removeItem", "datosProcesoEditorMovimiento");
        await JS.InvokeVoidAsync("destroyEditor");

        var clave = Id?.ToString() ?? "temporal";

        try
        {
            await Task.Run(() =>
            {
                EditorInfoService.Guardar(
                    clave: clave,
                    titulo: Titulo,
                    contenidoHtml: contenido
                );
            });

            // ✅ guardó OK => limpiar borradores (actual + mnuevo)
            await LimpiarBorradorAsync();

            var draftNuevoKey = $"draft_escrito_g{(_gestionIdStr ?? "0")}_mnuevo";
            await JS.InvokeVoidAsync("localStorage.removeItem", draftNuevoKey);
            await JS.InvokeVoidAsync("localStorage.removeItem", draftNuevoKey + "_titulo");

            _tieneCambios = false;
            _salidaIntencional = true;

            var returnUrl = await JS.InvokeAsync<string>("localStorage.getItem", "volverADespuesDeEditor");
            Nav.NavigateTo(!string.IsNullOrEmpty(returnUrl) ? returnUrl : "/gestiones");
        }
        catch
        {
            // ✅ si falla, NO limpies el borrador: así queda recuperable
            await JS.InvokeVoidAsync("mostrarToast", "No se pudo guardar. Se conservó el borrador.", "error");
        }
    }






    private async Task GuardarComoEscritoGlobal()
    {
        var contenido = await JS.InvokeAsync<string>("getEditorContent", "editor1");

        if (string.IsNullOrWhiteSpace(Titulo))
        {
            await JS.InvokeVoidAsync("mostrarToast", "Debe ingresar un título para guardar el escrito.", "error");
            return;
        }

        var ok = await EscritoService.GuardarEscritoAsync(Titulo, contenido);
        if (ok)
            await JS.InvokeVoidAsync("mostrarToast", "Escrito guardado correctamente.", "success");
        else
            await JS.InvokeVoidAsync("mostrarToast", "Error al guardar el escrito.", "error");
    }

