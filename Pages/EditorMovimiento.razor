    private async Task<bool> HayCambiosRealesAsync()
    {
        var tituloActual = (Titulo ?? "").Trim();
        var htmlActual = NormalizarHtml(await JS.InvokeAsync<string>("getEditorContent", "editor1"));

        // ✅ si no cambió nada real, no hay cambios
        if (tituloActual == _tituloOriginal && htmlActual == _htmlOriginal)
        {
            _tieneCambios = false;
            return false;
        }

        return true;
    }




