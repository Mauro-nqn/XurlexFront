    protected async Task ConfirmarSalida(LocationChangingContext context)
    {
        if (_salidaIntencional) return;          // ✅ no preguntar
        if (_confirmandoSalida) return;          // ✅ anti reentradas

        var hayCambios = await HayCambiosRealesAsync();
        if (!hayCambios) return;

        _confirmandoSalida = true;
        try
        {
            var confirmar = await JS.InvokeAsync<bool>(
                "confirm",
                "Hay cambios sin guardar en el escrito. ¿Querés salir y perderlos?"
            );

            if (!confirmar)
            {
                context.PreventNavigation();
                return;
            }

            await LimpiarBorradorAsync();
            _tieneCambios = false;
            await JS.InvokeVoidAsync("destroyEditor");
        }
        finally
        {
            _confirmandoSalida = false;
        }
    }



public void Dispose()
{
    _dotNetRef?.Dispose();
}




private async Task LimpiarBorradorAsync()
{
    await JS.InvokeVoidAsync("localStorage.removeItem", DraftKey);
    await JS.InvokeVoidAsync("localStorage.removeItem", DraftTituloKey);
    _hayBorrador = false;
    _borradorRestaurado = false;
}



