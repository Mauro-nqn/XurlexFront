    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || editorInicializado) return;

        editorInicializado = true;

        _cargandoEditor = true;
        _silenciarCambios = true;
        _tieneCambios = false;
        _borradorRestaurado = false;

        try
        {
            // ✅ 0) Contexto para DraftKey (ANTES de usar DraftKey)
            _gestionIdStr = await JS.InvokeAsync<string>("localStorage.getItem", "gestion_actual");

            var esApremioStr = await JS.InvokeAsync<string>("localStorage.getItem", "es_apremio");
            EsApremio = string.Equals(esApremioStr, "true", StringComparison.OrdinalIgnoreCase);
            MostrarBotonDemanda = EsApremio;

            string? base64 = null;
            string htmlBase = ""; // ✅ contenido “base” real para comparar borrador

            var clave = Id?.ToString() ?? "temporal";
            var info = EditorInfoService.Obtener(clave); // ❗️No lo limpies

            // 1) Fuente: EditorInfoService
            if (info is not null && !string.IsNullOrWhiteSpace(info.ContenidoHtml))
            {
                htmlBase = info.ContenidoHtml;
                base64 = ToBase64(htmlBase);
                Titulo = info.Titulo ?? string.Empty;
            }
            else
            {
                // 2) Fuente: localStorage “pasaje” temporal
                var contenido = await JS.InvokeAsync<string>("localStorage.getItem", "contenidoEditorMovimiento");
                var titulo = await JS.InvokeAsync<string>("localStorage.getItem", "tituloEditorMovimiento");

                if (!string.IsNullOrWhiteSpace(contenido))
                {
                    htmlBase = contenido;
                    base64 = ToBase64(htmlBase);
                    Titulo = titulo ?? string.Empty;

                    await JS.InvokeVoidAsync("localStorage.removeItem", "contenidoEditorMovimiento");
                    await JS.InvokeVoidAsync("localStorage.removeItem", "tituloEditorMovimiento");
                }
                else if (Id.HasValue)
                {
                    // 3) Fuente: backend
                    movimiento = await MovimientoService.ObtenerPorIdAsync(Id.Value);
                    if (movimiento != null && !string.IsNullOrWhiteSpace(movimiento.EscritoPersonalizadoHtml))
                    {
                        htmlBase = movimiento.EscritoPersonalizadoHtml;
                        base64 = ToBase64(htmlBase);
                        Titulo = movimiento.EscritoPersonalizadoTitulo ?? string.Empty;
                    }
                }
            }

            // ✅ init editor (nunca null)
            await JS.InvokeVoidAsync("initEditor", "editor1", base64 ?? "");

            // ✅ borrador (restaurar SOLO si es distinto del base)
            var borrador = await JS.InvokeAsync<string>("localStorage.getItem", DraftKey);
            var borradorTitulo = await JS.InvokeAsync<string>("localStorage.getItem", DraftTituloKey);

            bool borradorValido = !string.IsNullOrWhiteSpace(borrador);

            bool borradorEsDistinto =
                NormalizarHtml(borrador) != NormalizarHtml(htmlBase) ||
                (borradorTitulo ?? "").Trim() != (Titulo ?? "").Trim();

            _hayBorrador = borradorValido && borradorEsDistinto;

            if (_hayBorrador)
            {
                await JS.InvokeVoidAsync("setEditorContent", "editor1", borrador);

                if (!string.IsNullOrWhiteSpace(borradorTitulo))
                    Titulo = borradorTitulo;

                _tieneCambios = true;
                _borradorRestaurado = true;

                await JS.InvokeVoidAsync("mostrarToast", "Se restauró un borrador no guardado.", "info");
            }
            else
            {
                // ✅ si existe pero es igual (o basura), lo limpiamos y listo
                if (borradorValido)
                {
                    await JS.InvokeVoidAsync("localStorage.removeItem", DraftKey);
                    await JS.InvokeVoidAsync("localStorage.removeItem", DraftTituloKey);
                }
            }

            // ✅ bind dirty (después de setear contenido)
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("bindEditorDirty", "editor1", _dotNetRef, DraftKey, DraftTituloKey);

            DatosProcesoTexto = await JS.InvokeAsync<string>("localStorage.getItem", "datosProcesoEditorMovimiento");
            await JS.InvokeVoidAsync("localStorage.removeItem", "datosProcesoEditorMovimiento");

            // ✅ Snapshot + habilitar tracking
            await SnapshotOriginalAsync();
            if (_borradorRestaurado)
                _tieneCambios = true;

            // ✅ (opcional) limpiar borrador “mnuevo” al editar un escrito existente
            if (Id.HasValue)
            {
                var draftNuevoKey = $"draft_escrito_g{(_gestionIdStr ?? "0")}_mnuevo";
                await JS.InvokeVoidAsync("localStorage.removeItem", draftNuevoKey);
                await JS.InvokeVoidAsync("localStorage.removeItem", draftNuevoKey + "_titulo");
            }
        }
        finally
        {
            _silenciarCambios = false;
            _cargandoEditor = false;

            await InvokeAsync(StateHasChanged);
        }
    }



    private async Task SnapshotOriginalAsync()
    {
        _tituloOriginal = (Titulo ?? "").Trim();
        _htmlOriginal = NormalizarHtml(await JS.InvokeAsync<string>("getEditorContent", "editor1"));
        _tieneCambios = false; // importante
    }


    private static string NormalizarHtml(string? html)
    {
        if (string.IsNullOrWhiteSpace(html)) return "";

        var s = html.Replace("\u00A0", " ").Trim();

        var vacios = new[]
        {
        "<p><br></p>",
        "<p><br/></p>",
        "<p>&nbsp;</p>",
        "<p> </p>",
        "<div><br></div>",
        "<br>",
        "<br/>"
    };

        foreach (var v in vacios)
            if (string.Equals(s, v, StringComparison.OrdinalIgnoreCase))
                return "";

        s = System.Text.RegularExpressions.Regex.Replace(s, @"\s+", " ");
        return s.Trim();
    }







    [JSInvokable]
    public Task EditorChanged()
    {
        if (_silenciarCambios || _cargandoEditor)
            return Task.CompletedTask;

        _tieneCambios = true;
        _ = InvokeAsync(StateHasChanged);
        return Task.CompletedTask;
    }


