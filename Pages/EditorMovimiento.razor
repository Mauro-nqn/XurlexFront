    private async Task Cancelar()
    {
        if (_cancelando) return;
        _cancelando = true;

        try
        {
            var hayCambios = await HayCambiosRealesAsync();

            if (hayCambios)
            {
                var confirmar = await JS.InvokeAsync<bool>(
                    "confirm",
                    "Hay cambios sin guardar en el escrito. ¿Querés cancelar y perderlos?"
                );

                if (!confirmar)
                {
                    _cancelando = false;
                    return;
                }

                // // ✅ cortar autosave ANTES de limpiar borrador
                // try { await JS.InvokeVoidAsync("unbindEditorDirty", "editor1"); } catch { }

                // await LimpiarBorradorAsync();
                // _tieneCambios = false;
            }
            // else
            // {
            //     await LimpiarBorradorAsync();
            // }



            // ✅ SIEMPRE cortar autosave (haya cambios o no)
            try { await JS.InvokeVoidAsync("unbindEditorDirty", "editor1"); } catch { }

            // ✅ SIEMPRE limpiar borrador (haya cambios o no)
            await LimpiarBorradorAsync();
            _tieneCambios = false;

            _salidaIntencional = true; // ✅ evita NavigationLock

            var returnUrl = await JS.InvokeAsync<string>("localStorage.getItem", "volverADespuesDeEditor");
            await JS.InvokeVoidAsync("localStorage.removeItem", "datosProcesoEditorMovimiento");
            await JS.InvokeVoidAsync("destroyEditor");

            Nav.NavigateTo(!string.IsNullOrEmpty(returnUrl) ? returnUrl : "/gestiones");
        }
        finally
        {
            // si querés, no hace falta resetear si ya navegás
            // _salidaIntencional = false;
        }
    }






