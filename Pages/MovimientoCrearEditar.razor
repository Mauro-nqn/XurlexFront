                                    @bind="AgendarSincronizarGoogle" />
                                    <label class="form-check-label" for="chkSyncGoogleMov">
                                        Sincronizar con Google
                                    </label>
                                </div>
                            </div>
                        }

                        
                        @if (AgendarSincronizarGoogle )
                        {
                            <div class="card-body">
                            <div class="card">
                                <div class="card-body">

                                    <label class="form-label">Usuario Google</label>
                                    <InputSelect class="form-select" @bind-Value="AgendarUsuarioGoogleId" @bind-Value:after="VerificarUsuarioGoogleMovAsync">
                                        <option value="">-- Seleccione usuario --</option>
                                        @foreach (var u in Usuarios)
                                        {
                                            <option value="@u.Id">@u.Nombre</option>
                                        }
                                    </InputSelect>

                                    @if (AgendarGoogleVinculado == true)
                                    {
                                        <div class="text-success mt-1">✅ Vinculado: @AgendarGoogleEmail</div>
                                    }
                                    else if (AgendarGoogleVinculado == false)
                                    {
                                        <div class="text-danger mt-1">❌ Ese usuario no tiene cuenta Google vinculada</div>
                                    }
                                </div>
                            </div>
                            </div>
                        }
                        

            
                    @if (AgendaExistenteId.HasValue && AgendaGoogleRegistrado)
                    {
                     <div class="card-body">
                        <div class="alert alert-success d-flex justify-content-between align-items-center" style="margin-top:10px">
                            <div>
                                ✅ Sincronizado con Google.
                                @if (!string.IsNullOrWhiteSpace(AgendaGoogleHtmlLink))
                                {
                                    <a href="@AgendaGoogleHtmlLink" target="_blank" class="ms-2">Abrir en Google</a>
                                }
                                <small class="text-muted ms-2">
                                    Última sync: @AgendaGoogleLastSyncUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </small> <br>
                                <small class="text-muted ms-2">
                                            Sincro con Usuario: <strong>@AgendarGoogleEmail</strong>
                                </small>

                            </div>

                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ResincronizarAgendaMovAsync">
                                    🔄 Resincronizar
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="EliminarAgendaMovGoogleAsync">
                                    🗑️ Eliminar en Google
                                </button>
                            </div>
                        </div>
                      </div>

                    }

                        
          
                   
                        


                    </div>

