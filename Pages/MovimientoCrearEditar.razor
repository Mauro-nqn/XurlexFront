        <div class="mt-4">
            @* <button class="btn btn-primary me-2" type="submit"><i class="bi bi-floppy2"></i> Guardar</button> *@
            <button class="btn btn-primary" disabled="@IsSaving" @onclick="Guardar">
                <i class="bi bi-floppy2"></i> @(IsSaving ? "Guardando..." : "Guardar")
            </button>
            <button class="btn btn-secondary" type="button" @onclick="Volver"><i class="bi bi-arrow-left-circle"></i> Volver</button>
        </div>
    </EditForm>




    

</div>


@if (MostrarModalArchivo && ArchivoSeleccionadoParaVer is not null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@ArchivoSeleccionadoParaVer.Nombre</h5>
                    <button type="button" class="btn-close" @onclick="() => MostrarModalArchivo = false"></button>
                </div>
                <div class="modal-body">
                    @if (ArchivoSeleccionadoParaVer.TipoMime == "application/pdf")
                    {
                        <iframe src="@ArchivoSeleccionadoParaVer.DataUrlBase64" width="100%" height="600px"></iframe>
                    }
                    else if (ArchivoSeleccionadoParaVer.TipoMime.StartsWith("image/"))
                    {
                        <img src="@ArchivoSeleccionadoParaVer.DataUrlBase64" class="img-fluid" />
                    }
                    else
                    {
                        <p class="text-muted">No se puede mostrar vista previa.</p>
                    }
                </div>
            </div>
        </div>
    </div>
}