                    <label class="form-check-label" for="chkNotifMail">Aviso por email</label>
                </div>
            </div>


            
                    @if (AgendaNotificarEmail)
                    {
                     <div class="card-body">
                        <div class="card">
                            <div class="card-body">
                                <div class="row">
                                <div class="col-md-3">
                                <label class="form-label">Anticipación</label>
                                <InputSelect class="form-select" TValue="int?" @bind-Value="AgendaRecordatorioMinAntes">
                                    <option value="">-- Sin recordatorio --</option>
                                    @foreach (var r in RecordatorioOpciones)
                                    {
                                        <option value="@r.Min">@r.Label</option>
                                    }
                                </InputSelect>
                                </div>
                            
                            <div class="col-md-3">
                                <label class="form-label">Usuario (email)</label>
                                <InputSelect class="form-select" @bind-Value="AgendaNotificarEmailUsuarioId">
                                    <option value="">-- Otro correo --</option>
                                    @foreach (var u in Usuarios)
                                    {
                                        <option value="@u.Id">@u.Nombre (@u.email)</option>
                                    }
                                </InputSelect>
                                    </div>
                                    

                                @if (AgendaNotificarEmailUsuarioId is null)
                                {
                                    <div class="col-md-3">
                                        <label class="form-label">Correo destino</label>
                                        <InputText class="form-control" @bind-Value="AgendaNotificarEmailTo" />
                                    </div>
                                }
                            
                                </div>

                            </div>

             
                        </div>
                     </div>
