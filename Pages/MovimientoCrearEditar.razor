@attribute [Authorize]

@page "/movimientos/{tipo}/crear/{procesoId:int}"
@page "/movimientos/editar/{id:int}"
@using IurixBlazor.Shared.Enums;
@inherits MovimientoCrearEditarBase
@layout AdminLayout

<div class="container mt-4">
    <h3>@(EsEdicion ? "✏️ Editar Movimiento" : "➕ Nuevo Movimiento")</h3>

    @if (!string.IsNullOrEmpty(NombreProceso))
    {
        <div class="alert alert-info">
            <strong>Proceso:</strong> @NombreProceso
        </div>
    }

@*     @if (EsApremioMovimiento) {
        <div> ES APREMIO </div>
    } *@

    <EditForm Model="Modelo" OnValidSubmit="Guardar">
        <InputText class="form-control mb-2" @bind-Value="Modelo.Titulo" placeholder="Título" />
        <InputTextArea class="form-control mb-2" @bind-Value="Modelo.Detalle" placeholder="Detalle" />
        <InputDateTime class="form-control mb-2" @bind-Value="Modelo.Fecha" />

        <h6 class="mt-3">📝 Escrito</h6>
        <button class="btn btn-outline-primary mb-2" type="button" 
        style="margin-right:10px" @onclick="() => AbrirEditorMovimiento(MovimientoId)">
            ✍️ Editar Escrito
        </button>

        <!-- Título -->
        @if (!string.IsNullOrWhiteSpace(Modelo?.EscritoPersonalizadoHtml) || 
        !string.IsNullOrWhiteSpace(Modelo?.EscritoPersonalizadoTitulo))
        {
            <button class="btn btn-outline-danger ms-2 mb-2" type="button" 
            style="margin-right:10px" @onclick="EliminarEscritoAsync">
                <i class="bi bi-trash3-fill fs-5"></i> Quitar Escrito
            </button>
        }

        <strong>Título:</strong>
        <span class="text-muted ms-2">
            @Modelo.EscritoPersonalizadoTitulo
        </span>

        <!-- Resumen del contenido -->
        <div class="mt-1">
            <small class="text-muted">Contenido:</small>
            <div class="border p-2 bg-light rounded" style="max-height: 100px; overflow: hidden;">
                @EscritoPersonalizadoResumen
            </div>
        </div>



        

        <h6 class="mt-3">📎 Archivos adjuntos</h6>
        <InputFile OnChange="OnArchivoSeleccionado" multiple />

     

        

        @if (ArchivosTemporales.Any())
        {
            <div class="mt-3">
                @foreach (var archivo in ArchivosTemporales)
                {
                    @* <div class="border rounded p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong>@archivo.Nombre (@archivo.Extension)</strong>

                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-secondary"
                                        type="button"
                                        @onclick="() => VerArchivo(archivo)">
                                    👁️ Ver
                                </button>

                                <a class="btn btn-sm btn-outline-primary"
                                   href="@ObtenerUrlDescarga(archivo)"
                                   download="@archivo.Nombre">
                                    ⬇️ Descargar
                                </a>

                                <button class="btn btn-sm btn-outline-danger"
                                        type="button"
                                        @onclick="() => EliminarArchivo(archivo)">
                                    ❌ Quitar
                                </button>
                            </div>
                        </div>
                    </div> *@

                    <div class="border rounded p-3 mb-3">
                        <div class="text-break mb-2">
                            <strong>@archivo.Nombre</strong>
                            <span class="text-muted">(@archivo.Extension)</span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button class="btn btn-sm btn-outline-secondary"
                                    type="button"
                                    @onclick="() => VerArchivo(archivo)">
                                <i class="bi bi-eye me-1"></i> Ver
                            </button>

                            <a class="btn btn-sm btn-outline-primary"
                               href="@ObtenerUrlDescarga(archivo)"
                               download="@archivo.Nombre">
                                <i class="bi bi-download me-1"></i> Descargar
                            </a>

                            <button class="btn btn-sm btn-outline-danger"
                                    type="button"
                                    @onclick="() => EliminarArchivo(archivo)">
                                <i class="bi bi-x-circle me-1"></i> Quitar
                            </button>
                        </div>
                    </div>

                }
            </div>
        }

        <div class="row align-items-center">
            <div class="col-md-3">
                <h6 class="mt-4">📅 Agendar este movimiento</h6>

                <div class="form-check form-switch mb-2" style="margin-top:10px">
                    <input type="checkbox" class="form-check-input" id="swAgendar" @bind="Agendar" />
                    <label class="form-check-label" for="swAgendar">Crear evento en la agenda</label>
                </div>
            </div>

            <div class="col-md-3">
            @if (AgendaExistenteId.HasValue)
            
            {
            
            
                <button class="btn btn-outline-danger" 
                        type="button"
                        @onclick="EliminarAgendaActual">
                    <i class="bi bi-trash3-fill"></i> Quitar agenda
                </button>
            
            }
                </div>
        </div>

