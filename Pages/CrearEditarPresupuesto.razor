@attribute [Authorize]

@page "/presupuestos/editar/{Id:int?}"
@inherits CrearEditarPresupuestoBase
@layout AdminLayout


@using IurixBlazor.Shared.Enums

<div class="container mt-4 presupuesto-form">
    <h3>@(Id.HasValue ? "✏️ Editar Presupuesto" : "➕ Nuevo Presupuesto")</h3>

    <EditForm Model="@Presupuesto" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <ValidationSummary />

        @if (!string.IsNullOrWhiteSpace(AlertText))
        {
            <div class="alert alert-@AlertCss mt-2">@AlertText</div>
        }

        <!--Nombre-->
        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <InputText class="form-control" 
            @bind-Value="Presupuesto.Nombre"
                       disabled="@(!PuedeEditarEstado())" />
        </div>


        <!-- Cliente -->
        <div class="mb-3">
            <label>Cliente</label>
            <InputSelect class="form-control" 
            @bind-Value="Presupuesto.PersonaId"
                         disabled="@(!PuedeEditarEstado())">
                <option value="0">-- Seleccione --</option>
                @foreach (var cli in Personas)
                {
                    <option value="@cli.Id">@((cli.Tipo == TipoPersona.Juridica ? cli.RazonSocial : $"{cli.Apellido}, {cli.Nombre}"))</option>
                }
            </InputSelect>
        </div>

@*         <div class="alert alert-info">
            PersonaId en Presupuesto: @Presupuesto?.PersonaId
            <br />
            Cantidad de Personas: @Personas?.Count
        </div>

        @if (Personas != null)
        {
            <ul>
                @foreach (var p in Personas)
                {
                    <li>@p.Id - @(p.Tipo == TipoPersona.Juridica ? p.RazonSocial : $"{p.Apellido}, {p.Nombre}")</li>
                }
            </ul>
        } *@


        <!-- Distribución de Honorarios -->
        <div class="mb-3">
            <label>Distribución de Honorarios</label>
            <InputSelect class="form-control" 
            @bind-Value="Presupuesto.DistribucionHonorarioId"
                         disabled="@(!PuedeEditarEstado())">
                <option value="0">-- Seleccione --</option>
                @foreach (var dist in Distribuciones)
                {
                    <option value="@dist.Id">@dist.Nombre</option>
                }
            </InputSelect>
        </div>

        <!-- Fecha y Estado -->
        <div class="row">
            <div class="col-md-6">
                <label>Fecha</label>
                <InputDate class="form-control" 
                @bind-Value="Presupuesto.Fecha" 
                           disabled="@(!PuedeEditarEstado())" />
            </div>

            <div class="col-md-3">
                <label>Validez (días)</label>
                <InputNumber class="form-control" 
                @bind-Value="Presupuesto.PlazoValidezDias" 
                disabled="@(!PuedeEditarEstado())"/>
            </div>

            

     @*        <div class="col-md-6">
                <label>Estado</label>
                <InputSelect class="form-control" @bind-Value="Presupuesto.Estado">
                    @foreach (var estado in Enum.GetValues<EstadoPresupuesto>())
                    {
                        <option value="@estado">@estado</option>
                    }
                </InputSelect>
            </div> *@

           @*  <div class="col-md-6">
                <label>Estado</label>

                <InputSelect @key="selectKey"
                             class="form-control"
                             @bind-Value="Presupuesto.Estado"
                             disabled="@(!PuedeEditarEstado())">
                    @foreach (var estado in EstadosVisibles())
                    {
