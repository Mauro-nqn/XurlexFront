                <small class="text-muted ms-2">@leyendaFecha</small>
            }

        </div> *@

        @if (Presupuesto.Estado != EstadoPresupuesto.FacturadoTotal)
        {
            <div>
                @{
                    var (badgeCss, badgeText) = Presupuesto.AjusteEstado switch
                    {
                        AjusteEstadoPresupuesto.AlDia => ("bg-success", "Presupuesto actualizado"),
                        AjusteEstadoPresupuesto.Desfasado => ("bg-warning text-dark", "Presupuesto desactualizado"),
                        _ => ("bg-secondary", "Sin actualizar")
                    };

                    var tieneFecha = Presupuesto.RevalorizadoUtc.HasValue;
                    var fechaStr = tieneFecha
                    ? Presupuesto.RevalorizadoUtc!.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    : null;

                    string? leyendaFecha = Presupuesto.AjusteEstado switch
                    {
                        AjusteEstadoPresupuesto.AlDia => tieneFecha
                        ? $"Actualizado: {fechaStr}"
                        : "Actualizado (sin fecha)",
                        AjusteEstadoPresupuesto.Desfasado => tieneFecha
                        ? $"Última actualización: {fechaStr}"
                        : "Nunca revalorizado",
                        _ => null
                    };
                }

                <span class="badge @badgeCss">@badgeText</span>

                @if (!string.IsNullOrEmpty(leyendaFecha))
                {
                    <small class="text-muted ms-2">@leyendaFecha</small>
                }
            </div>
        }


        <button class="btn btn-primary me-2 mt-3" type="submit">💾 Guardar</button>
        
        
        
   @*      @if (Id.HasValue && Detalles.Any(d => d.AjusteVariableId.HasValue))
        {
            <button type="button" class="btn btn-primary me-2 mt-3" style="background-color:azure; color: black" @onclick="Revalorizar">
                🔄 Actualizar Valores
            </button>
        }
        <button class="btn btn-secondary mt-3" type="button" @onclick="Cancelar">Cancelar</button> *@

        @if (Id.HasValue
                && Detalles.Any(d => d.AjusteVariableId.HasValue)
                && (Presupuesto.AjusteEstado == AjusteEstadoPresupuesto.Desfasado)
                && (Presupuesto.Estado != EstadoPresupuesto.FacturadoTotal))
        {
            <button type="button"
                    class="btn btn-primary me-2 mt-3"
                    style="background-color:azure; color: black"
                    @onclick="Revalorizar">
