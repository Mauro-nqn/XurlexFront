            <div class="col-md-6">
                <label>Estado</label>

                @if (EsNuevo)
                {
                    
                    <!-- Creación: solo Presupuestado, deshabilitado -->
                    <InputSelect class="form-control"
                                 TValue="EstadoPresupuesto"
                                 Value="Presupuesto.Estado"
                                 ValueExpression="() => Presupuesto.Estado"
                                 disabled>
                        <option value="@EstadoPresupuesto.Presupuestado">Presupuestado</option>
                    </InputSelect>
                }
                else
                {
                    <!-- Edición: lista completa y auto-guardar al cambiar -->
                    <InputSelect @key="selectKey"
                                 class="form-control"
                                 TValue="EstadoPresupuesto"
                                 Value="Presupuesto.Estado"
                                 ValueChanged="@(async (EstadoPresupuesto e) => await OnEstadoChangedAsync(e))"
                                 ValueExpression="() => Presupuesto.Estado"
                                 disabled="@(!PuedeEditarEstado())">
                        @foreach (var estado in EstadosVisibles())
                        {
                            <option value="@estado">@estado</option>
                        }
                    </InputSelect>

                    @if (!PuedeEditarEstado())
                    {
                        <small class="text-muted">@MensajeBloqueoEstado()</small>
                    }
                }
            </div>

            <div class="col-12 col-md-5 col-lg-3">
                @* <label>Variable de ajuste (opcional)</label> *@

                <label class="form-label d-flex align-items-center">
                    Variable de ajuste (opcional)
                    <span class="ms-2"
                          tabindex="0"
                          data-bs-toggle="popover"
                          data-bs-trigger="focus"
                          data-bs-placement="top"
                          data-bs-content="Permite ajustar el presupuesto por variables. Seleccionar, guardar y reingresar para ->Actualizar Valores">
                        <i class="bi bi-info-circle"></i>
                    </span>
                </label>

                <InputSelect class="form-control"
                             @bind-Value="AjusteVariableGlobalId"
                             disabled="@EstaBloqueadoDetalles()"
                             title="Permite ajustar el presupuesto por variables. Seleccionar, guardar y reingresar para ->Actualizar Valores">
                    >
                    <option value="">— Sin variable —</option>
                    @foreach (var v in Variables)
                    {
                        <option value="@v.Id">@v.Nombre (@v.Clave) — @v.ValorActual</option>
                    }
                </InputSelect>
                @* <small class="text-muted">
                    Se marca la variable en todos los ítems actuales y nuevos. No cambia precios ahora.
                </small> *@

                <!-- ESTADO USADO VS ACTUAL (solo si hay variable activa en las líneas) -->
                <!-- ESTADO USADO VS ACTUAL (solo si hay variable activa en las líneas) -->
                @if (AjusteVariableGlobalId is not null)
                {
                    // Tomamos la primera línea que tenga esa variable
                    var d = Detalles.FirstOrDefault(x => x.AjusteVariableId == AjusteVariableGlobalId);

                    if (d is not null)
                    {
                        <span class="badge bg-light text-muted mt-2">
                            Índice @d.AjusteVariableClave:
                            usado @d.VariableValorUsado?.ToString("N0")
                            — actual @d.AjusteVariableValorActual?.ToString("N0")
                        </span>
                    }
                }
            </div>
   
        </div>

       @*   <div class="d-flex justify-content-end me-2" style="margin-top:10px">
           


            @if (Presupuesto.Estado == EstadoPresupuesto.Aprobado && !CargoPresupuestoYaCargado)
