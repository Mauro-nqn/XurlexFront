        @* <div class="d-flex justify-content-end me-2" style="margin-top:10px; margin-left: 20px">
            @if (Id.HasValue && Presupuesto.Estado == EstadoPresupuesto.Aprobado && !CargoPresupuestoYaCargado)
            {
                <button type="button"
                        class="btn btn-outline-primary ms-2"
                        disabled="@BusyCtaCte"
                        @onclick="AgregarACtaCte">
                    ➕ Agregar a Cuenta Corriente
                </button>
            }
            @if (Id.HasValue && Presupuesto.Estado == EstadoPresupuesto.Aprobado && CargoPresupuestoYaCargado)
            {
                <button type="button"
                        class="btn btn-outline-danger ms-2"
                        disabled="@BusyCtaCte"
                        @onclick="RetirarDeCtaCte">
                    ✖️ Retirar de Cuenta Corriente
                </button>
            }
        </div> *@


        <!-- Detalles -->
        <h5 class="mt-3">Detalles</h5>
        <div class="table-responsive"
        <table class="table">
            <thead>
                <tr>
                    <th >Cantidad</th>
                    <th >Descripción</th>
                    <th >Precio Unitario</th>
                    <th >IVA</th>
                    <th >Subtotal</th>
                    <th ></th>
                </tr>
            </thead>
            <tbody>
               

                @{
                    var bloqueado = EstaBloqueadoDetalles();
                }

                @foreach (var det in Detalles)
                {
                    var cantidadChanged = EventCallback.Factory.Create<decimal>(this, v => OnDetalleChanged(det, v, nameof(PresupuestoDetalleDto.Cantidad)));
                    var precioChanged = EventCallback.Factory.Create<decimal>(this, v => OnDetalleChanged(det, v, nameof(PresupuestoDetalleDto.PrecioUnitario)));

                    <tr>
                        <td style="width:100px">
                            <InputNumber class="form-control"
                                         Value="det.Cantidad"
                                         ValueChanged="@cantidadChanged"
                                         ValueExpression="@(() => det.Cantidad)"
                                         disabled="@bloqueado" />
                        </td>

                        <td>
                            <InputText class="form-control"
                                       Value="@det.Descripcion"
                                       ValueChanged="@( (string v) => OnDetalleDescripcionChanged(det, v) )"
                                       ValueExpression="@(() => det.Descripcion)"
                                       disabled="@EstaBloqueadoDetalles()" />

                        </td>

                        <td style="max-width:160px">
                            <InputNumber class="form-control"
                                         Value="det.PrecioUnitario"
                                         ValueChanged="@precioChanged"
                                         ValueExpression="@(() => det.PrecioUnitario)"
                                         disabled="@bloqueado" />
                        </td>

                        <td>
                            <InputSelect class="form-control"
                                         Value="det.IvaAlicuotaId"
                                         ValueChanged="@((int v) => OnDetalleChanged(det, v, nameof(PresupuestoDetalleDto.IvaAlicuotaId)))"
                                         ValueExpression="@(() => det.IvaAlicuotaId)"
                                         disabled="@bloqueado">
                                @foreach (var iva in IvaAlicuotas)
                                {
                                    <option value="@iva.Id">@iva.Nombre (@iva.Porcentaje%)</option>
                                }
                            </InputSelect>
                        </td>

                        <td>@det.Subtotal.ToString("C")</td>
                        <td>
                            @if (!bloqueado)
                            {
                                <button type="button" class="btn btn-danger btn-sm" @onclick="() => EliminarDetalle(det)">🗑</button>
                            }
                        </td>
                    </tr>
                }
                <div>
                
                </div>
                </tbody>
        </table>
        <button type="button" class="btn btn-secondary mb-3" style="margin-left:5px" @onclick="AgregarDetalle" disabled="@bloqueado">
                    ➕ Agregar Detalle
                </button>
        </div>

        <!-- Totales -->
        <div class="row text-end">
            <div class="col-12">
                <p><strong>Neto:</strong> @Presupuesto.Neto.ToString("C")</p>
                <p><strong>IVA:</strong> @Presupuesto.Iva.ToString("C")</p>
                <h5><strong>Total:</strong> @Presupuesto.Total.ToString("C")</h5>
            </div>
        </div>

      

        <div class="mb-3">
            <label>Observaciones</label>
            <InputTextArea class="form-control" rows="3" @bind-Value="Presupuesto.Observaciones" />
        </div>

