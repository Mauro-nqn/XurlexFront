@attribute [Authorize]

@page "/caracteresintervencion/crear-editar/{Id:int?}"
@inherits CrearEditarCaracterIntervencionBase
@layout AdminLayout

<div class="container mt-4 caracter-form">
    <h3>@(Id.HasValue ? "✏️ Editar Carácter de Intervención" : "➕ Nuevo Carácter de Intervención")</h3>

    <EditForm Model="@Caracter" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <InputText class="form-control" @bind-Value="Caracter.Nombre" />
        </div>

        <button class="btn btn-primary me-2" type="submit">💾 Guardar</button>
        @if (Id.HasValue)
        {
            <button class="btn btn-danger" type="button" @onclick="Eliminar">🗑️ Eliminar</button>
        }
        <button class="btn btn-secondary ms-2" type="button" @onclick="Cancelar">Cancelar</button>
    </EditForm>
</div>
