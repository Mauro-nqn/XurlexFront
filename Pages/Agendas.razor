



 @attribute [Authorize]



@page "/agendas"
@inherits AgendasBase
@layout AdminLayout
@using IurixBlazor.Shared.Enums

<div class="container mt-4 agendas-page">
   

         <!-- Encabezado alineado CON la card -->
<div class="container px-0 mb-3">
    <div class="row align-items-center g-2">
        <div class="col">
            <h3 class="m-0">🗓️ Agenda de Eventos</h3>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="NuevaAgenda">
                <i class="bi bi-plus-lg"></i> Nuevo
            </button>
        </div>
    </div>
</div>

  


  <div class="card mb-3 shadow-sm">
  <div class="card-body">

    <div class="row g-3 align-items-end">
      <div class="col-12 col-md-3">
        <label class="form-label">Modo fecha</label>
        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" id="swRango"
                 @bind="UsarRango" @bind:after="OnToggleRangoAsync" />
          <label class="form-check-label" for="swRango">
            @(UsarRango ? "Rango de fechas" : "Un día")
          </label>
        </div>
      </div>

      @if (!UsarRango)
      {
        <div class="col-12 col-md-4">
          <label class="form-label">Fecha</label>
          <div class="input-group">
            <InputDate @bind-Value="FiltroFecha"
                       class="form-control"
                        /> @* @bind-Value:after="BuscarAgendaAsync" *@
            <button class="btn btn-outline-secondary" type="button" title="Quitar fecha" @onclick="LimpiarFechaAsync">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
        </div>
      }
      else
      {
        <div class="col-12 col-md-4">
          <label class="form-label">Desde</label>
          <InputDate @bind-Value="FiltroDesde"
                     class="form-control"
                      /> @* @bind-Value:after="BuscarAgendaAsync" *@
        </div>
        <div class="col-12 col-md-4">
          <label class="form-label">Hasta</label>
          <InputDate @bind-Value="FiltroHasta"
                     class="form-control"
                      /> @* @bind-Value:after="BuscarAgendaAsync" *@
        </div>
        <div class="col-12 col-md-2">
          <label class="form-label d-none d-md-block">&nbsp;</label>
          <button class="btn btn-outline-secondary w-100" type="button" @onclick="LimpiarRangoAsync">
            Limpiar rango
          </button>
        </div>
      }

      <div class="col-12 col-md-3">
      <label class="form-label">Orden</label>
      <InputSelect class="form-select"
                   @bind-Value="OrdenFecha"
                   @bind-Value:after="OnOrdenChangedAsync">
        <option value="desc">Más nuevo primero</option>
        <option value="asc">Más viejo primero</option>
      </InputSelect>
    </div>

      <div class="col-12 col-md-3">
        <label class="form-label">Estado</label>
        <InputSelect class="form-select"
                     @bind-Value="FiltroEstado"
                     @bind-Value:after="BuscarAgendaAsync">
          <option value="">Todos</option>
          <option value="@EstadoAgenda.Pendiente">Pendiente</option>
          <option value="@EstadoAgenda.Realizado">Realizado</option>
          <option value="@EstadoAgenda.Cancelado">Cancelado</option>
          <option value="@EstadoAgenda.Reprogramado">Reprogramado</option>
        </InputSelect>
      </div>

      <div class="col-12 col-md-5">
        <label class="form-label">Buscar</label>
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-search"></i></span>
          <input class="form-control"
                 placeholder="Cliente, título u observación…"
                 @bind="FiltroBusqueda" 
                  /> @* @bind:event="oninput" @bind:after="OnSearchInputAsync" *@
        </div>
      </div>

      <div class="col-12 col-md-4 text-md-end">
        <label class="form-label d-none d-md-block">&nbsp;</label>
        <div class="d-grid d-md-flex gap-2">
@*           <button class="btn btn-primary w-100" @onclick="NuevaAgenda">
            <i class="bi bi-plus-lg"></i> Nuevo
          </button> *@
          <button class="btn btn-outline-secondary" @onclick="LimpiarFiltros">
            Limpiar todo
          </button>
          <button class="btn btn-outline-primary" @onclick="BuscarAgendaAsync">
              Filtrar
          </button>

        </div>
      </div>
   @*  </div> *@



        <hr class="my-3" />

    <div class="row g-3">
      <div class="col-12">
        <label class="form-label me-3">Usuarios</label>

        <div class="form-check form-check-inline">
        <input class="form-check-input" type="checkbox" id="chkTodos"
               @bind="FiltroTodosUsuarios"
               @bind:after="OnToggleTodosAsync" />
        @* <label class="form-check-label" for="chkTodos">Todos</label> *@
          <label class="form-check-label" for="chkTodos">Todos</label>
        </div>

         @if (!FiltroTodosUsuarios)
        {
          <div class="d-flex flex-wrap gap-3 mt-2">
            @foreach (var u in ListaUsuarios)
            {
              <div class="form-check">
                <input class="form-check-input" type="checkbox"
                       checked="@FiltroUsuarioIds.Contains(u.Id)"
                       @onchange="(ChangeEventArgs e) => OnToggleUsuarioAsync(u.Id, e.Value is bool b && b)" />
                <label class="form-check-label">@u.Nombre</label>
              </div>
            }
          </div>

          @* Chips de seleccionados (visual) *@
          @if (FiltroUsuarioIds.Count > 0)
          {
            <div class="mt-2">
              @foreach (var uid in FiltroUsuarioIds)
              {
                var nombre = ListaUsuarios.FirstOrDefault(x => x.Id == uid)?.Nombre ?? $"ID {uid}";
                <span class="badge bg-light text-dark me-2">
                  <i class="bi bi-person"></i> @nombre
                </span>
              }
            </div>
          }
        }
      </div>
    </div>
 

  </div>
</div>


  

    </div>



