@attribute [Authorize]

@page "/facturas"
@inherits FacturasListadoBase
@layout AdminLayout
@using IurixBlazor.Shared.Dtos
@using iurixGo.Client.Pages.FacturaListado


<div class="container mt-4 facturas-container">
    <h3>📄 Listado de Facturas</h3>
    
    @* <button class="btn btn-primary mb-3" @onclick="NuevaFactura">➕ Nueva Factura</button> *@

    <div class="row g-3 align-items-end">
        <div class="col-12 col-md-3">
            <label class="form-label">Desde</label>
            <InputDate @bind-Value="FiltroDesde" class="form-control" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label">Hasta</label>
            <InputDate @bind-Value="FiltroHasta" class="form-control" />
        </div>

        <div class="col-12 col-md-3">
            <label class="form-label">Tipo</label>
            <select class="form-select" @bind="FiltroOperacion">
                <option value="">Todos</option>
                <option value="Factura">Facturas</option>
                <option value="NotaCredito">Notas de Crédito</option>
                <option value="NotaDebito">Notas de Débito</option>
            </select>
        </div>

        <div class="col-12 col-md-3">
            <label class="form-label">Cliente</label>
            <InputSelect @bind-Value="FiltroPersonaId" class="form-control">
                <option value="">— Todos —</option>
                @foreach (var cli in Personas)
                {
                    <option value="@cli.Id">
                        @(!string.IsNullOrWhiteSpace(cli.RazonSocial)
                                            ? cli.RazonSocial
                                            : $"{cli.Apellido}, {cli.Nombre}")
                </option>
                                }
            </InputSelect>
        </div>

        <div class="col-12 col-md-3">
            <label class="form-label">Usuario emisor</label>
            <InputSelect @bind-Value="FiltroUsuarioId" class="form-control">
                <option value="">— Todos —</option>
                @foreach (var u in Usuarios)
                {
                    <option value="@u.Id">@u.Nombre</option> @* o Email *@
                }
            </InputSelect>
        </div>

        <div class="col-12 col-md-3">
            <label class="form-label">Punto de venta</label>
            <InputSelect @bind-Value="FiltroPuntoVentaId" class="form-control">
                <option value="">— Todos —</option>
                @foreach (var pv in PuntosVenta)
                {
                    <option value="@pv.Id">@(pv.Numero.ToString("D4")) — @pv.Descripcion</option>
                }
            </InputSelect>
        </div>

        <div class="col-12 col-md-3">
            <label class="form-label">Número (ej: 0001-00001234)</label>
            <InputText @bind-Value="FiltroNumero" class="form-control" />
        </div>

        <div class="col-12 col-md-3" style="align-items:center">
            <button class="btn btn-outline-primary" @onclick="Buscar">🔎 Buscar</button>
            <button class="btn btn-outline-secondary" @onclick="Limpiar">↺ Limpiar</button>
        </div>

        <PermisoView Permiso="@Permisos.Facturas.Crear">
        <div class="col-12 col-md-3" style="align-items:center">
            <button class="btn btn-primary ms-auto" @onclick="NuevaFactura">➕ Nueva Factura</button>
        </div>
        </PermisoView>

    </div>


