    @if (!esMovil)   @* Igual que en Personas / Gestiones / Agenda *@
    {

        <table class="table table-striped table-hover shadow-sm" style="margin-top:20px">
            <thead class="table-dark">
                <tr>

                    <th>Tipo</th>
                    <th>Número</th>
                    <th>Cliente</th>
                    <th>Fecha</th>
                    <th>Total</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Facturas == null)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">Cargando...</td>
                    </tr>
                }
                else if (!Facturas.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">No se encontraron facturas.</td>
                    </tr>
                }
                else
                {
                    @foreach (var factura in Facturas)
                    {
                        <tr>
                            <td>@factura.TipoComprobanteDescripcion</td>
                            <td>
                                @((factura.PuntoVentaNumero.HasValue
                                                    ? $"{factura.PuntoVentaNumero.Value:D4}-{factura.Numero:D8}"
                                                    : factura.Numero.ToString()))
                            </td>
                            <td>
                                @if (factura.PersonaId > 0)
                                {
                                    if (!string.IsNullOrWhiteSpace(factura.PersonaRazonSocial))
                                    {
                                        @factura.PersonaRazonSocial
                                    }
                                    else
                                    {
                                        @($"{factura.PersonaApellido}, {factura.PersonaNombre}")
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">Sin persona</span>
                                }
                            </td>
                            <td>@factura.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@factura.Total.ToString("C")</td>
                            <td class="text-nowrap acciones-cell">

                                <PermisoView Permiso="@Permisos.Facturas.Ver">
                                    <button class="btn btn-info btn-sm accion-btn"
                                        @onclick="() => VerDetalle(factura.Id)">
                                    👁 Ver
                                </button>
                                </PermisoView>

                                <PermisoView Permiso="@Permisos.Facturas.Ver">
                                    <button class="btn btn-info btn-sm accion-btn"
                                        @onclick="() => ImprimirFactura(factura.Id)">
                                    🖨 Imprimir
                                </button>
                                </PermisoView>

                                <PermisoView Permiso="@Permisos.Facturas.Eliminar">
                                <button class="btn btn-sm btn-danger accion-btn"
                                        @onclick="() => EliminarFactura(factura.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                                </PermisoView>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
    else
    {
        <!-- 📱 MOBILE: facturas como cards -->
        <div class="facturas-cards mt-3">
            @if (Facturas == null)
            {
                <div class="text-center text-muted py-3">Cargando...</div>
            }
            else if (!Facturas.Any())
            {
                <div class="text-center text-muted py-3">No se encontraron facturas.</div>
            }
            else
            {
                @foreach (var factura in Facturas)
                {
                    var numeroCompleto = factura.PuntoVentaNumero.HasValue
                    ? $"{factura.PuntoVentaNumero.Value:D4}-{factura.Numero:D8}"
                    : factura.Numero.ToString();

                    var tipoComprobante = string.IsNullOrWhiteSpace(factura.TipoComprobanteDescripcion)
         || factura.TipoComprobanteDescripcion == "null"
             ? "Comprobante sin identificar"
             : factura.TipoComprobanteDescripcion;


                    var clienteTexto = factura.PersonaId > 0
                    ? (!string.IsNullOrWhiteSpace(factura.PersonaRazonSocial)
                    ? factura.PersonaRazonSocial
                    : $"{factura.PersonaApellido}, {factura.PersonaNombre}")
                    : "Sin persona";

                    <div class="card factura-card shadow-sm mb-2">
                        <div class="card-body">
                            <!-- Número + fecha + total -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <div class="fw-semibold factura-numero">
                                        @tipoComprobante
                                    </div>

                                    <div class="fw-semibold factura-numero">
                                        📄 @numeroCompleto
                                    </div>
                                    <div class="text-muted small">
                                        @factura.Fecha.ToString("dd/MM/yyyy")
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="small text-muted">Total</div>
                                    <div class="fw-bold factura-total">
                                        @factura.Total.ToString("C")
                                    </div>
                                </div>
                            </div>

                            <!-- Cliente -->
                            <div class="small mb-2">
                                <strong>Cliente:</strong>
                                <span class="ms-1">
                                    @if (factura.PersonaId > 0)
                                    {
                                        @clienteTexto
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin persona</span>
                                    }
                                </span>
                            </div>

                            <!-- Acciones -->
                            <div class="d-flex flex-column flex-sm-row gap-2 mt-2">
                                <PermisoView Permiso="@Permisos.Facturas.Ver">
                                <button class="btn btn-sm btn-outline-primary flex-fill"
                                        @onclick="() => VerDetalle(factura.Id)">
                                    👁 Ver
                                </button>
                                </PermisoView>

                                <PermisoView Permiso="@Permisos.Facturas.Ver">
                                <button class="btn btn-sm btn-outline-secondary flex-fill"
                                        @onclick="() => ImprimirFactura(factura.Id)">
                                    🖨 Imprimir
                                </button>
                                </PermisoView>

                                <PermisoView Permiso="@Permisos.Facturas.Eliminar">
                                <button class="btn btn-sm btn-danger flex-fill"
                                        @onclick="() => EliminarFactura(factura.Id)">
                                    🗑️ Eliminar
                                </button>
                                </PermisoView>


                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }

</div>
