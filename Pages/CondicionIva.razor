@attribute [Authorize]

@page "/condicioniva"
@inherits CondicionIvaBase
@layout AdminLayout

<div class="container mt-4">
    <h3>📋 Condiciones de IVA</h3>
    <button class="btn btn-success mb-3" @onclick="NuevaCondicion">➕ Nueva Condición</button>

    @if (Condiciones == null)
    {
        <p>Cargando...</p>
    }
    else if (!Condiciones.Any())
    {
        <p>No hay condiciones de IVA registradas.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Código AFIP</th>
                    <th>Alicuota (%)</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Condiciones)
                {
                    <tr>
                        <td>@c.Nombre</td>
                        <td>@c.CodigoAfip</td>
                        <td>@(c.AlicuotaGeneral?.ToString("F2") ?? "-")</td>
                        <td>
                            <button class="btn btn-primary btn-sm" @onclick="() => EditarCondicion(c.Id)">✏️ Editar</button>
                            <button class="btn btn-danger btn-sm ms-2" @onclick="() => EliminarCondicion(c.Id)">🗑️ Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
