                <div class="modal-body">
                    <EditForm Model="modelo" OnValidSubmit="Generar">
                        <DataAnnotationsValidator />

                        <!-- ABOGADA / ABOGADO -->
                        <h6>Abogada / Abogado</h6>

                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <InputText class="form-control" @bind-Value="modelo.Abogado.Nombre" placeholder="Nombre" />
                            </div>
                            <div class="col-md-6">
                                <InputText class="form-control" @bind-Value="modelo.Abogado.Apellido" placeholder="Apellido" />
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-md-4">
                                <InputText class="form-control" @bind-Value="modelo.Abogado.Matricula" placeholder="Matrícula" />
                            </div>
                            <div class="col-md-4">
                                <InputText class="form-control" @bind-Value="modelo.Abogado.Cuit" placeholder="CUIT" />
                            </div>
                            <div class="col-md-4">
                                <InputText class="form-control" @bind-Value="modelo.Abogado.CondicionIva" placeholder="Condición IVA" />
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
