                                <InputText class="form-control" @bind-Value="modelo.Abogado.DomicilioProcesal" placeholder="Domicilio procesal" />
                            </div>
                            <div class="col-md-4">
                                <InputText class="form-control" @bind-Value="modelo.Abogado.DomicilioElectronico" placeholder="Domicilio electrónico" />
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <InputText class="form-control" @bind-Value="modelo.Abogado.Ciudad" placeholder="Ciudad" />
                            </div>
                            <div class="col-md-6">
                                <InputText class="form-control" @bind-Value="modelo.Abogado.Provincia" placeholder="Provincia" />
                            </div>
                        </div>

                        <hr />

                        <!-- ACTOR / CLIENTE -->
                        <h6>Actor (Cliente)</h6>

                        <div class="row g-2 mb-2">
                            <div class="col-md-12">
                                <InputText class="form-control" @bind-Value="modelo.Cliente.Nombre" placeholder="Cliente / Actor" />
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-md-8">
                                <InputText class="form-control" @bind-Value="modelo.Cliente.Domicilio" placeholder="Domicilio actor" />
                            </div>
                            <div class="col-md-4">
                                <InputText class="form-control" @bind-Value="modelo.Cliente.Cuit" placeholder="CUIT actor" />
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <InputText class="form-control" @bind-Value="modelo.Cliente.Ciudad" placeholder="Ciudad actor" />
                            </div>
                            <div class="col-md-6">
                                <InputText class="form-control" @bind-Value="modelo.Cliente.Provincia" placeholder="Provincia actor" />
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-4">
                                <InputText class="form-control" @bind-Value="modelo.Cliente.Dni" placeholder="DNI actor" />
                            </div>
                        </div>

                        <hr />

                        <!-- DEMANDADO / DEUDOR -->
                        <h6>Demandado (Deudor)</h6>

                        <div class="row g-2 mb-2">
                            <div class="col-md-12">
                                <InputText class="form-control" @bind-Value="modelo.Deudor.Nombre" placeholder="Deudor / Demandado" />
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
