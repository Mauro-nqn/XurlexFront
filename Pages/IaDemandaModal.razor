                                <InputText class="form-control" @bind-Value="modelo.Deudor.Domicilio" placeholder="Domicilio demandado" />
                            </div>
                            <div class="col-md-4">
                                <InputText class="form-control" @bind-Value="modelo.Deudor.Cuit" placeholder="CUIT demandado" />
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
