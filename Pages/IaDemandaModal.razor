                                <InputText class="form-control" @bind-Value="modelo.Deudor.Ciudad" placeholder="Ciudad demandado" />
                            </div>
                            <div class="col-md-6">
                                <InputText class="form-control" @bind-Value="modelo.Deudor.Provincia" placeholder="Provincia demandado" />
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-4">
                                <InputText class="form-control" @bind-Value="modelo.Deudor.Dni" placeholder="DNI demandado" />
                            </div>
                        </div>

                        <hr />

                        <!-- CERTIFICADO DE DEUDA -->
