                            <div class="row g-2 align-items-center">
                                <div class="col-md-8">
                                    <InputFile OnChange="OnCertificadoPdfSeleccionado" accept="application/pdf" />
                                </div>
                                <div class="col-md-4 text-end">
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            @onclick="ProcesarCertificadoPdf">
                                        Leer datos del certificado
                                    </button>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(CertificadoMensaje))
                            {
                                <div class="mt-2 small text-muted">@CertificadoMensaje</div>
                            }
                        </div>

                        <button class="btn btn-primary mt-2" type="submit">Generar demanda</button>

