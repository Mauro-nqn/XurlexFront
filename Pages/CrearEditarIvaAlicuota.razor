@attribute [Authorize]

@page "/ivaalicuotas/editar/{Id:int?}"
@inherits CrearEditarIvaAlicuotaBase
@layout AdminLayout

<div class="container mt-4 ivaalicuota-form">
    <h3>@(Id.HasValue ? "✏️ Editar Alícuota de IVA" : "➕ Nueva Alícuota de IVA")</h3>

    <EditForm Model="@Alicuota" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <InputText class="form-control" @bind-Value="Alicuota.Nombre" />
        </div>

        <div class="mb-3">
            <label class="form-label">Porcentaje (%)</label>
            <InputNumber class="form-control" @bind-Value="Alicuota.Porcentaje" />
        </div>

        <div class="mb-3">
            <label class="form-label">Codigo AFIP</label>
            <InputNumber class="form-control" @bind-Value="Alicuota.CodigoAfip" />
        </div>

        <button class="btn btn-primary me-2" type="submit">💾 Guardar</button>
        @if (Id.HasValue)
        {
            <button class="btn btn-danger" type="button" @onclick="Eliminar">🗑️ Eliminar</button>
        }
        <button class="btn btn-secondary ms-2" type="button" @onclick="Cancelar">Cancelar</button>
    </EditForm>
</div>
