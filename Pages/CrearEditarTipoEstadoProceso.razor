@attribute [Authorize]

@page "/tiposestadoproceso/crear-editar/{Id:int?}"
@inherits CrearEditarTipoEstadoProcesoBase
@layout AdminLayout

<div class="container mt-4 tipoestado-form">
    <h3>@(Id.HasValue ? "✏️ Editar Estado de Proceso" : "➕ Nuevo Estado de Proceso")</h3>

    <EditForm Model="@Estado" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <InputText class="form-control" @bind-Value="Estado.Nombre" />
        </div>

        <div class="mb-3">
            <label class="form-label">Tipo de Proceso</label>
            <InputSelect class="form-select" @bind-Value="Estado.TipoProceso">
                <option value="">Seleccione...</option>
                <option value="Judicial">Judicial</option>
                <option value="Extrajudicial">Extrajudicial</option>
            </InputSelect>
        </div>

        <button class="btn btn-primary me-2" type="submit">💾 Guardar</button>
        @if (Id.HasValue)
        {
            <button class="btn btn-danger" type="button" @onclick="Eliminar">🗑️ Eliminar</button>
        }
        <button class="btn btn-secondary ms-2" type="button" @onclick="Cancelar">Cancelar</button>
    </EditForm>
</div>
