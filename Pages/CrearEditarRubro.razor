@attribute [Authorize]

@page "/rubros/editar/{Id:int?}"
@inherits CrearEditarRubroBase
@layout AdminLayout

<EditForm Model="Rubro" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="container mt-4 form-page-container">
        <h3>@(Id.HasValue ? "✏️ Editar Rubro" : "➕ Nuevo Rubro")</h3>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label>Nombre</label>
                <InputText class="form-control" @bind-Value="Rubro.Nombre" />
            </div>

            <div class="col-md-6 mb-3">
                <label>Tipo</label>
                <InputSelect class="form-select" @bind-Value="Rubro.Tipo">
                    <option value="">-- Seleccione --</option>
                    @foreach (var t in Tipos)
                    {
                        <option value="@t">@t</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3 d-flex align-items-center">
                <div class="form-check mt-3">
                    <InputCheckbox id="activo" class="form-check-input" @bind-Value="Rubro.Activo" />
                    <label for="activo" class="form-check-label ms-2">Activo</label>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <button type="submit" class="btn btn-success">💾 Guardar</button>
            <button type="button" class="btn btn-secondary" @onclick="Cancelar">↩️ Cancelar</button>
        </div>
    </div>
</EditForm>
