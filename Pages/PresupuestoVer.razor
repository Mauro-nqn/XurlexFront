<style>

    /* Fondo y tarjeta del modal */
    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.5);
        z-index: 1050;
    }

    .modal-card {
        position: fixed;
        z-index: 1060;
        left: 50%;
        top: 0.5vh; /* distancia desde arriba */
        bottom: 0.5vh; /*distancia desde abajo */
        transform: translateX(-50%);
        width: min(1080px, 96vw); /* agrandado pero responsivo */
        max-height: 90vh; /* 🔹 límite de alto */
        display: flex; /* 🔹 para que el body pueda scroll */
        flex-direction: column;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,.25);
    }

    /* Header pegado arriba al hacer scroll */
    .modal-header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: #fff;
        border-bottom: 1px solid #e9ecef;
        padding: .75rem 1rem;
        /* 🔹 reponemos el layout de Bootstrap */
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

        /* Fallback por si el background-image de .btn-close se pierde */
        .modal-header .btn-close {
            width: 1.25rem;
            height: 1.25rem;
            opacity: .85;
            background: none !important;
            position: relative;
        }

            .modal-header .btn-close::before {
                content: "\00D7"; /* × */
                position: absolute;
                inset: 0;
                display: grid;
