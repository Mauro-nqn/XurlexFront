@attribute [Authorize]

@page "/puntos-venta/editar/{Id:int?}"
@inherits CrearEditarPuntoVentaBase
@layout AdminLayout

<EditForm Model="Punto" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="container mt-4 crear-editar-punto-venta">
        <h3>@(Id.HasValue ? "✏️ Editar Punto de Venta" : "➕ Nuevo Punto de Venta")</h3>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label for="numero">Número</label>
                <InputNumber id="numero" class="form-control" @bind-Value="Punto.Numero" />
            </div>

            <div class="col-md-8 mb-3">
                <label for="descripcion">Descripción</label>
                <InputText id="descripcion" class="form-control" @bind-Value="Punto.Descripcion" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3 d-flex align-items-center">
                <div class="form-check mt-3">
                    <InputCheckbox id="activo" class="form-check-input" @bind-Value="Punto.Activo" />
                    <label for="activo" class="form-check-label ms-2">Activo</label>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3 d-flex align-items-center">
                <div class="form-check mt-3">
                    <InputCheckbox id="activo" class="form-check-input" @bind-Value="Punto.UsaNumeracionLocal" />
                    <label for="activo" class="form-check-label ms-2">Usa Numeracion Local</label>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <button type="submit" class="btn btn-success">💾 Guardar</button>
            <button type="button" class="btn btn-secondary" @onclick="Cancelar">↩️ Cancelar</button>
        </div>
    </div>
</EditForm>
