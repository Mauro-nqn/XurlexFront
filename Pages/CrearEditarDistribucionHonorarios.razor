@attribute [Authorize]

@page "/distribucion-honorarios/editar/{Id:int?}"
@inherits CrearEditarDistribucionHonorariosBase
@layout AdminLayout

<div class="container mt-4 distribucion-honorarios-form">
    <h3>@(Id.HasValue ? "✏️ Editar Distribución de Honorarios" : "➕ Nueva Distribución de Honorarios")</h3>

    <EditForm Model="@Distribucion" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Nombre</label>
            <InputText class="form-control" @bind-Value="Distribucion.Nombre" />
        </div>

        <div class="mb-3">
            <label>Descripción</label>
            <InputTextArea class="form-control" @bind-Value="Distribucion.Descripcion" />
        </div>

        <h5 class="mt-4">Detalles de Distribución</h5>

        <table class="table table-bordered mt-2">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Porcentaje</th>
                    <th>Concepto</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detalle in Detalles)
                {
                    <tr>
                        <td>
                            <InputSelect class="form-control" @bind-Value="detalle.UsuarioId">
                                <option value="">-- Seleccione --</option>
                                @foreach (var usuario in Usuarios)
                                {
                                    <option value="@usuario.Id">@usuario.NombreUsuario</option>
                                }
                            </InputSelect>
                        </td>
                        <td>
                            <InputNumber class="form-control" @bind-Value="detalle.Porcentaje" />
                        </td>
                        <td>
                            <InputText class="form-control" @bind-Value="detalle.Concepto" />
                        </td>
                        <td>
                            <button type="button" class="btn btn-danger btn-sm" @onclick="() => EliminarDetalle(detalle)">🗑️</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="button" class="btn btn-secondary mb-3" @onclick="AgregarDetalle">➕ Agregar Detalle</button>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary me-2">💾 Guardar Distribución</button>
            <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
        </div>
    </EditForm>
</div>
