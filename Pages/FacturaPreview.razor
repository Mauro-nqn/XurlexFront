@code{

    protected bool EsA =>
    factura != null &&
    (string.Equals(factura.TipoComprobanteLetra, "A", StringComparison.OrdinalIgnoreCase) || factura.CbteTipo == 1);

    protected bool EsB =>
        factura != null &&
        (string.Equals(factura.TipoComprobanteLetra, "B", StringComparison.OrdinalIgnoreCase) || factura.CbteTipo == 6);

    protected bool EsC =>
        factura != null &&
        (string.Equals(factura.TipoComprobanteLetra, "C", StringComparison.OrdinalIgnoreCase) || factura.CbteTipo == 11);

    // En Argentina: si la letra es A o B, el emisor es RI.
    protected bool EmisorEsRI => EsA || EsB;





    string DocLabel(int t) => t switch
    {
        80 => "CUIT",        
        96 => "DNI",
        _ => "Doc"
    };

    string FormatDoc(int t, string? nro)
    {
        if (string.IsNullOrWhiteSpace(nro)) return "";
        // Formato XX-XXXXXXXX-X para CUIT/CUIL si tiene 11 dígitos
        if (t is 80 or 86)
        {
            var digits = new string(nro.Where(char.IsDigit).ToArray());
            if (digits.Length == 11)
                return $"{digits.Substring(0, 2)}-{digits.Substring(2, 8)}-{digits.Substring(10, 1)}";
        }
        return nro!;
    }


    
    

}

