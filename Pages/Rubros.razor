@attribute [Authorize]

@page "/rubros"
@inherits RubrosBase
@layout AdminLayout

<div class="container mt-4 list-page-container">
    <h3>📚 Rubros</h3>

    <button class="btn btn-primary mb-3" @onclick="Nuevo">➕ Nuevo Rubro</button>

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Tipo</th>
                <th>Activo</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Rubros.Count == 0)
            {
                <tr><td colspan="4" class="text-center text-muted">No hay rubros.</td></tr>
            }
            else
            {
                @foreach (var r in Rubros)
                {
                    <tr>
                        <td>@r.Nombre</td>
                        <td>@r.Tipo</td>
                        <td>@(r.Activo == true ? "Sí" : "No")</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-info me-2" @onclick="() => Editar(r.Id)">✏️ Editar</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => Eliminar(r.Id)">🗑️ Eliminar</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
