@attribute [Authorize]

@page "/secretarias/crear-editar/{Id:int?}"
@inherits CrearEditarSecretariaBase
@layout AdminLayout

<div class="container mt-4 secretaria-form">
    <h3>@(Id.HasValue ? "✏️ Editar Secretaría" : "➕ Nueva Secretaría")</h3>

    <EditForm Model="@Secretaria" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <ValidationSummary />

        
        <!-- Jurisdicción -->
        <div class="mb-3">
            <label class="form-label">Jurisdicción</label>
            <InputSelect class="form-select"
                         @bind-Value="JurisdiccionSeleccionada">
                <option value="">Seleccione...</option>
                @foreach (var j in Jurisdicciones)
                {
                    <option value="@j.Id">@j.Nombre</option>
                }
            </InputSelect>
        </div>


        
        <!-- Circunscripción -->
        <div class="mb-3">
            <label class="form-label">Circunscripción</label>
            <InputSelect class="form-select"
                         @bind-Value="CircunscripcionSeleccionada"
                         disabled="@(!Circunscripciones.Any())">
                <option value="">Seleccione...</option>
                @foreach (var c in Circunscripciones)
                {
                    <option value="@c.Id">@c.Nombre</option>
                }
            </InputSelect>
        </div>

        <!-- Juzgado -->
        <div class="mb-3">
            <label class="form-label">Juzgado</label>
            <InputSelect class="form-select" @bind-Value="Secretaria.JuzgadoId"
                         disabled="@(!Juzgados.Any())">
                <option value="">Seleccione...</option>
                @foreach (var j in Juzgados)
                {
                    <option value="@j.Id">@j.Nombre</option>
                }
            </InputSelect>
        </div>

        <!-- Campos de Secretaría -->
        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <InputText class="form-control" @bind-Value="Secretaria.Nombre" />
        </div>
        <div class="mb-3">
            <label class="form-label">Juez</label>
            <InputText class="form-control" @bind-Value="Secretaria.Juez" />
        </div>
        <div class="mb-3">
            <label class="form-label">Secretario</label>
            <InputText class="form-control" @bind-Value="Secretaria.Secretario" />
        </div>

        <!-- Botones -->
        <button class="btn btn-primary me-2" type="submit">💾 Guardar</button>
        @if (Id.HasValue)
        {
            <button class="btn btn-danger" type="button" @onclick="Eliminar">🗑️ Eliminar</button>
        }
        <button class="btn btn-secondary ms-2" type="button" @onclick="Cancelar">Cancelar</button>
    </EditForm>
</div>



