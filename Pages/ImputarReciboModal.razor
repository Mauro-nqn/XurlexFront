@inherits ImputarReciboModalBase

@using IurixBlazor.Shared.Enums
@using IurixBlazor.Shared.Dtos

@if (Visible)
{
    @* BACKDROP *@
    <div class="modal-backdrop-custom" @onclick="CerrarImputar"></div>

    @* CONTENIDO MODAL *@
    <div class="modal-custom">
        <div class="modal-header d-flex justify-content-between align-items-center">
            <h5 class="m-0">Imputar recibo N.º @_reciboId</h5>
            <button class="btn btn-sm btn-outline-secondary" @onclick="CerrarImputar">✕</button>
        </div>

        <div class="modal-body">
            <div class="mb-2 text-muted">
                <b>Saldo del recibo:</b> @SaldoDisponible.ToString("C")
            </div>

            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Concepto</th>
                        <th class="text-end">Saldo débito</th>
                        <th class="text-end" style="width:160px">Imputar</th>
                    </tr>
                </thead>
                <tbody>
                    @if (DebitosAbiertosModal?.Count > 0)
                    {
                        @foreach (var row in DebitosAbiertosModal)
                        {
                            <tr>
                                <td>
                                    @(row.Debito.Fecha.HasValue
                                                            ? row.Debito.Fecha.Value.ToLocalTime().ToString("dd/MM/yyyy")
                                                            : "-")
                                </td>

                                <td>@row.Debito.Detalle</td>
                                <td class="text-end">@row.Saldo.ToString("C")</td>
                                <td class="text-end">
                                    <input class="form-control form-control-sm text-end"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           max="@row.Saldo"
                                           value="@row.Imputar"
                                           @oninput="(e => OnImputarChanged(row, e))" />
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-3">
                                No hay débitos abiertos para imputar.
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end"><b>Total a imputar</b></td>
                        <td class="text-end"><b>@TotalAImputar.ToString("C")</b></td>
                    </tr>
                </tfoot>
            </table>

            @if (!string.IsNullOrEmpty(ValidacionError))
            {
                <div class="alert alert-warning py-2 my-2">
                    @ValidacionError
                </div>
            }
        </div>

        <div class="modal-footer d-flex justify-content-end gap-2">
            <button class="btn btn-outline-secondary" @onclick="CerrarImputar">Cancelar</button>
            <button class="btn btn-success"
                    disabled="@(!PuedeConfirmarImputacion)"
                    @onclick="ConfirmarImputacionesRecibo">
                Confirmar imputación
            </button>
        </div>
    </div>
}
