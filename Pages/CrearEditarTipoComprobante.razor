@attribute [Authorize]

@page "/tipo-comprobantes/editar/{Codigo:int?}"
@inherits CrearEditarTipoComprobanteBase
@layout AdminLayout

<EditForm Model="Tipo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="container mt-4 crear-editar-tipo-comprobante">
        <h3>@(Codigo.HasValue ? "✏️ Editar Tipo de Comprobante" : "➕ Nuevo Tipo de Comprobante")</h3>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label for="codigo">Código</label>
                <InputNumber id="codigo" class="form-control" @bind-Value="Tipo.Id" disabled="@Codigo.HasValue" />
            </div>

            <div class="col-md-6 mb-3">
                <label for="letra">Letra</label>
                <InputText id="letra" class="form-control" @bind-Value="Tipo.Letra" />
            </div>
        </div>

        <div class="mb-3">
            <label for="descripcion">Descripción</label>
            <InputText id="descripcion" class="form-control" @bind-Value="Tipo.Descripcion" />
        </div>

        <div class="d-flex justify-content-between mt-4">
            <button type="submit" class="btn btn-success">💾 Guardar</button>
            <button type="button" class="btn btn-secondary" @onclick="Cancelar">↩️ Cancelar</button>
        </div>
    </div>
</EditForm>


