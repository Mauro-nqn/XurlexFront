                                        <div class="col-md-6">
                                            <label class="form-label">Estado</label>
                                            <InputSelect class="form-select" @bind-Value="Gestion.ProcesoExtrajudicial.EstadoId">
                                                <option value="">Seleccione…</option>
                                                @foreach (var e in EstadosExtrajudiciales)
                                                {
                                                    <option value="@e.Id">@e.Nombre</option>
                                                }
                                            </InputSelect>
                                        </div>
                                    </div>
                                }

                                <div class="mt-3">
                                    <button type="submit" class="btn btn-primary"><i class="bi bi-floppy2-fill"></i> <span style="margin-left:3px">Guardar</span></button>
                                    <button type="button" class="btn btn-secondary ms-2" @onclick="Close"> <i class="bi bi-x-circle"></i> <span style="margin-left:3px"> Cerrar </span></button>
                                </div>
                            </EditForm> *@
                        }
                else if (Tab == 2)
                {
                    @if (Form.TipoGestion == "Judicial" && ProcesoId.HasValue)
{
                        <MovimientosEmbed Tipo="Judicial"
                                          ProcesoId="@ProcesoId.Value"
                                          ParentModalSelector="@ModalId" />
}
                    else if (Form.TipoGestion == "Extrajudicial" && ProcesoId.HasValue)
{
                        <MovimientosEmbed Tipo="Extrajudicial"
                                          ProcesoId="@ProcesoId.Value"
                                          ParentModalSelector="@ModalId" />
}
                    else
                    {
                        <div class="text-muted">Esta gestión no tiene proceso asociado.</div>
                    }
                }
            </div>
        }
      </div>
    </div>
  </div>
</div>
