                                        <div class="col-md-6">
                                            <label class="form-label">Domicilio Constituido</label>
                                            <InputSelect class="form-select" @bind-Value="Gestion.ProcesoJudicial.DomicilioConstituidoId">
                                                <option value="">Seleccione…</option>
                                                @foreach (var d in DomiciliosConstituidos)
