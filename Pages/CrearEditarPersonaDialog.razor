


@* MOSTRAR FORM SOLO SI _editContext NO ES NULL *@
@* @if (_editContext is null)
{
    
    <div class="p-3">Cargando…</div>
    
}
else
{
   
<EditForm EditContext="_editContext" OnValidSubmit="OnSubmitInternal">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <h5 class="mb-3">@Titulo</h5>

    <!-- Tipo + Clasificación -->
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Tipo de Persona</label>
            <InputSelect class="form-select" @bind-Value="Model.Tipo" @onchange="OnTipoChanged">
                @foreach (var t in TiposPersona)
                {
                    <option value="@t">@t</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Clasificación</label>
            <InputSelect class="form-select" @bind-Value="Model.ClasificacionId">
                @foreach (var c in Clasificaciones)
                {
                    <option value="@c.Id">@c.Nombre</option>
                }
            </InputSelect>
        </div>
    </div>

    @if (Model.Tipo == TipoPersona.Fisica)
    {
        <!-- Física -->
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Nombre</label>
                <InputText class="form-control" @bind-Value="Model.Nombre" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Apellido</label>
                <InputText class="form-control" @bind-Value="Model.Apellido" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">DNI</label>
                <InputText class="form-control" @bind-Value="Model.DNI" @oninput="OnDniChanged"
                           disabled="@(!string.IsNullOrWhiteSpace(Model.CUIT))" />
                <ValidationMessage For="@(() => Model.DNI)" class="text-danger" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">CUIT</label>
                <div class="input-group">
                    <InputText class="form-control"
                               @bind-Value="Model.CUIT"
                               @oninput="(e) => { FormatearCuitEnTiempoReal(e); OnCuitChanged(); }"
                               @onblur="ValidarCuit" />
                    <button class="btn btn-outline-info" type="button" @onclick="ConsultarAfip">🔍 AFIP</button>
                </div>
                @if (!string.IsNullOrEmpty(CuitError))
                {
                    <div class="text-danger">@CuitError</div>
                }
                <ValidationMessage For="@(() => Model.CUIT)" class="text-danger" />
            </div>
        </div>
    }
    else
    {
        <!-- Jurídica -->
        <div class="mb-3">
            <label class="form-label">Razón Social</label>
            <InputText class="form-control" @bind-Value="Model.RazonSocial" />
        </div>
        <div class="mb-3">
            <label class="form-label">CUIT</label>
            <InputText class="form-control"
                       @bind-Value="Model.CUIT"
                       @oninput="(e) => { FormatearCuitEnTiempoReal(e); OnCuitChanged(); }"
                       @onblur="ValidarCuit" />
            @if (!string.IsNullOrEmpty(CuitError))
            {
                <div class="text-danger">@CuitError</div>
            }
            <ValidationMessage For="@(() => Model.CUIT)" class="text-danger" />
        </div>
    }

    <!-- Condición IVA (se bloquea si es Física con DNI y sin CUIT) -->
    <div class="mb-3">
        <label class="form-label">Condición IVA</label>
        <InputSelect class="form-select" @bind-Value="Model.CondicionIVAId" disabled="@BloquearCondicionIva">
            @foreach (var cond in CondicionesIVA)
            {
                <option value="@cond.Id">@cond.Nombre</option>
            }
        </InputSelect>
        <ValidationMessage For="@(() => Model.CondicionIVAId)" class="text-danger" />
    </div>

    <!-- Contacto -->
    <div class="mb-3">
        <label class="form-label">Email</label>
        <InputText class="form-control" @bind-Value="Model.Email" @oninput="(_) => RevalidarCampo(() => Model.Email)" />
        <ValidationMessage For="@(() => Model.Email)" class="text-danger" />
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Teléfono</label>
            <InputText class="form-control" @bind-Value="Model.Telefono" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Celular</label>
            <InputText class="form-control" @bind-Value="Model.Celular" />
        </div>
    </div>

    <!-- Dirección -->
    <div class="mb-3">
        <label class="form-label">Domicilio</label>
        <InputText class="form-control" @bind-Value="Model.Domicilio" />
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Ciudad</label>
            <InputText class="form-control" @bind-Value="Model.Ciudad" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Código Postal</label>
            <InputText class="form-control" @bind-Value="Model.CodigoPostal" />
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Provincia</label>
        <InputText class="form-control" @bind-Value="Model.Provincia" />
    </div>

    <div class="mb-3">
        <label class="form-label">Observaciones</label>
        <InputTextArea class="form-control" @bind-Value="Model.Observacion" />
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit">💾 Guardar</button>
        <button class="btn btn-secondary" type="button" @onclick="Cancelar">Cancelar</button>
    </div>
</EditForm>

    
        
    
}


