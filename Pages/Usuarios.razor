@attribute [Authorize]
@using IurixBlazor.Services
@using IurixBlazor.Pages
@inject UsuarioActualService UsuarioActual

@page "/usuarios"
@inherits UsuariosBase
@layout AdminLayout



<!-- Contenedor principal -->
<div class="usuarios-container container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">👥 Gestión de Usuarios</h2>
        @if (PuedeCrear)
        {
            <button class="btn btn-success shadow-sm" @onclick="NuevoUsuario">
                <i class="bi bi-person-plus"></i> Nuevo Usuario
            </button>
        }
    </div>

    <p class="text-muted">@CantidadUsuariosLabel</p>

    @if (IsBusy)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" style="width: 4rem; height: 4rem;" role="status"></div>
            <p class="mt-3">Cargando usuarios...</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var usuario in Usuarios)
            {
                <div class="col">
                    <div class="card usuario-card shadow-sm">
                        <div class="card-body d-flex justify-content-between">
                            <div>
                                <h5 class="fw-bold">@usuario.NombreUsuario</h5>
                                <p class="mb-1 text-muted">@usuario.NombreCompleto</p>
                                <span class="badge bg-secondary">@usuario.RolNombre</span>
                            </div>
                            <div class="d-flex flex-column align-items-end gap-2">
                                 @* @if (usuario.PuedeEditar)
                                {
                                    <button class="btn btn-sm btn-primary" @onclick="() => EditarUsuario(usuario.Id)">
                                        <i class="bi bi-pencil-square fs-5"></i>
                                    </button>
                                }
                                @if (usuario.PuedeEliminar)
                                {
                                    <button class="btn btn-sm btn-danger" @onclick="() => EliminarUsuario(usuario.Id, usuario.NombreUsuario)">
                                        <i class="bi bi-trash3-fill fs-5"></i>
                                    </button>
                                }  *@

                                 <PermisoView Permiso="@Permisos.Usuarios.Editar">
                                    <button class="btn btn-sm btn-primary" @onclick="() => EditarUsuario(usuario.Id)">
                                        <i class="bi bi-pencil-square fs-5"></i>
                                    </button>
                                </PermisoView>

                                <PermisoView Permiso="@Permisos.Usuarios.Eliminar">
                                    <button class="btn btn-sm btn-danger" @onclick="() => EliminarUsuario(usuario.Id, usuario.NombreUsuario)">
                                        <i class="bi bi-trash3-fill fs-5"></i>
                                    </button>
                                </PermisoView>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
