@page "/collabora"
@attribute [Authorize]
@layout AdminLayout

@using IurixBlazor.Shared.Dtos
@using IurixBlazor.Shared.Services
@using Microsoft.AspNetCore.Components.Forms

@inject CollaboraService CollaboraService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold">📄 Escritos Collabora</h3>
            <p class="text-muted mb-0">
                Prueba del nuevo editor DOCX
            </p>
        </div>


        <div class="d-flex gap-2">

            <InputFile id="archivoCollabora"
                       OnChange="ImportarArchivo"
                       accept=".docx,.rtf,.txt,.pdf"
                       style="display:none" />

            <label for="archivoCollabora"
                   class="btn btn-outline-primary mb-0">
                📂 Importar archivo
            </label>

            <button class="btn btn-primary"
                    @onclick="Nuevo">
                ➕ Nuevo escrito
            </button>

        </div>
    </div>

    @if (cargando)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-3">Cargando escritos...</p>
        </div>
    }
    else if (!escritos.Any())
    {
        <div class="alert alert-light border">
            No hay escritos Collabora.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-3">

            @foreach (var escrito in escritos)
            {
                <div class="col">
                    <div class="card shadow-sm">

                        <div class="card-body d-flex
                            justify-content-between
                            align-items-center">

                            <div>
                                <h5 class="fw-bold">
                                    @escrito.Titulo
                                </h5>
                                @if (!string.IsNullOrWhiteSpace(escrito.Formato))
                                {
                                    <span class="badge bg-secondary text-uppercase">
                                        @escrito.Formato
                                    </span>
                                }


                                <small class="text-muted">
                                    Creado:
                                    @escrito.FechaCreacion
                                    .ToLocalTime()
                                    .ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>

                            <div class="d-flex gap-2">

                                <button class="btn btn-outline-primary"
                                        @onclick="() => Abrir(escrito.Id)">
                                    ✏️ Abrir
                                </button>

                                <button class="btn btn-outline-danger"
                                        @onclick="() => Eliminar(escrito)">
                                    🗑️ Eliminar
                                </button>

                            </div>

                        </div>
                    </div>
                </div>
            }

        </div>
    }

</div>

