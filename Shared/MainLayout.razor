    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // if (firstRender && !redireccionHecha)
        // {
        //     redireccionHecha = true;




        //     var currentUri = Nav.ToBaseRelativePath(Nav.Uri).ToLower();
        //     if (currentUri.StartsWith("login"))
        //         return;

        //     var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        //     var user = authState.User;

        //     if (!user.Identity?.IsAuthenticated ?? true)
        //     {
        //         // Estamos en una vista no autorizada, dejá que Blazor muestre el mensaje
        //         return;
        //     }

        //     var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");
        //     if (string.IsNullOrEmpty(token))
        //     {
        //         Nav.NavigateTo("/login", forceLoad: true);
        //     }
        // }
  
        if (!firstRender || _initHecho)
            return;

        _initHecho = true;

        // 1) Inicializar Bearer del GoogleService desde localStorage (JS seguro)
        try
        {
            await GoogleService.InitAsync();
        }
        catch (JSDisconnectedException) { /* ignorar: volverá a renderizar */ }
        catch (JSException) { /* ignorar o loguear */ }

        // 2) Si estamos en /login, no forzar nada
        var currentUri = Nav.ToBaseRelativePath(Nav.Uri);
        if (currentUri.StartsWith("login", StringComparison.OrdinalIgnoreCase))
            return;

        // 3) Verificar autenticación de Blazor
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (!user.Identity?.IsAuthenticated ?? true)
            return; // dejar que la vista muestre "no autorizado"

        // 4) Asegurar que hay token de app en localStorage; si no, redirigir
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");
            if (string.IsNullOrEmpty(token))
            {
                Nav.NavigateTo("/login", forceLoad: true);
                return;
            }
        }
        catch (JSException)
        {
            // Si falla JS por algún motivo, mejor ir a /login para re-hidratar
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

         // 5) Registrar el callback que llamará JS -> C# cuando venza la inactividad
        SesionInterop.OnCerrarSesionSolicitada = async () =>
        {
            try
            {
                // Opcional: asegurar que se detiene la lógica JS
                await JS.InvokeVoidAsync("detenerInactividad");
            }
            catch { /* si falla JS no nos frena el logout */ }

            // TODO: si tenés AuthService, lo ideal es:
            // await AuthService.LogoutAsync();

            Nav.NavigateTo("/login", forceLoad: true);
        };

        // 6) Arrancar el timer de inactividad en JS
        try
        {
            await JS.InvokeVoidAsync("iniciarInactividad");
        }
        catch (JSException)
        {
            // si falla, simplemente no se usa auto-logout por inactividad
        }

    
    }

}


